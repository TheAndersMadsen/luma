# Source-owned public device edge. The deployment transaction replaces the two
# @@...@@ tokens with decimal loopback backends, writes the rendered file
# atomically into /etc/nginx/streams-enabled/, runs `nginx -t`, asserts the
# single-owner invariant below. This
# file lives in the `stream` context (nginx.conf: `stream { include
# /etc/nginx/streams-enabled/*.conf; }`), not in `http`.
#
# WHY A STREAM AND NOT A VHOST
# The Pin presents a client certificate and Envoy is the only component permitted
# to see it — that is what makes an authenticated device principal trustworthy on
# the far side. An nginx `server` block with `ssl_certificate` would terminate the
# handshake here, end mTLS at the wrong hop, and quietly convert every device into
# an unauthenticated caller. `ssl_preread` reads only the SNI out of the plaintext
# ClientHello and then copies bytes in both directions, so the certificate, the
# ALPN negotiation and the whole handshake stay end to end between Pin and Envoy.
#
# WHY THIS OWNS THE PUBLIC :443
# CosmosRemoteTransport redirects every clone gateway to <host>:443, so the device
# dials 443 and nothing else. One address:port can have exactly one owner inside
# one nginx, so the public bind lives here and Center's TLS listener was moved to
# a loopback port that this file feeds for every other SNI.
#
# WHY A GATE GUARDS IT
# `nginx -t` does NOT detect an http/stream collision on the same address:port: it
# answers "syntax is ok" and the master then fails to bind at reload, which is how
# an earlier attempt at this change took the whole host's ingress down. domain.py's
# `nginx-assert-443-owner` therefore parses the expanded configuration (`nginx -T`,
# which reads from disk without applying anything) and requires exactly one file in
# the whole tree to bind a non-loopback :443. It runs after `nginx -t` and before
# any reload, so a violation fails the deploy while the running nginx is still
# serving its previous configuration.

# Session-level log for the plane that, before this file existed, produced zero
# server-side lines for a device that dialled every two minutes forever: the
# ClientHello died at a port nothing served, so no request line was ever reached
# and neither the access log nor the error log had anything to say. One line per
# TCP session, whatever happens to it, is the evidence that was missing.
# $ssl_preread_server_name is the name the device asked for, $upstream_addr is
# where it went (empty means it was refused before a backend was chosen), and
# $ssl_preread_alpn_protocols separates a gRPC client from a browser.
log_format ai_pin_revival_device_edge
    '$time_iso8601 $remote_addr sni=$ssl_preread_server_name '
    'alpn=$ssl_preread_alpn_protocols tls=$ssl_preread_protocol '
    'backend=$ai_pin_revival_443_backend upstream=$upstream_addr '
    'status=$status sent=$bytes_sent received=$bytes_received '
    'connect=$upstream_connect_time session=$session_time';

# Every clone gateway Envoy declares a filter chain for, and nothing else. This
# list must equal the union of `filter_chain_match.server_names` across
# platform/edge/envoy/envoy.yaml.tpl; render-envoy.py refuses to render the edge
# if the two ever diverge, because a name the device is redirected to but the
# server does not serve is exactly the failure this file exists to end. An SNI
# that is not listed is served locally rather than silently handed to the mTLS
# edge, where it would fail as a certificate error instead of as a 404.
map $ssl_preread_server_name $ai_pin_revival_443_backend {
    hostnames;

    default                          ai_pin_revival_local_tls;

    api.cosmos.humane.cloud          ai_pin_revival_device_edge;
    api.clone.invalid                ai_pin_revival_device_edge;
    eastus.cosmos.humane.cloud       ai_pin_revival_device_edge;
    eastus-1.cosmos.humane.cloud     ai_pin_revival_device_edge;
    onboarding.cosmos.humane.cloud   ai_pin_revival_device_edge;
    onboarding.clone.invalid         ai_pin_revival_device_edge;
    cosmos-edge                      ai_pin_revival_device_edge;
}

# `max_fails=0` on both single-server groups: passive health checking has nothing
# to fail over to here, so marking the only backend down would blackhole the plane
# for `fail_timeout` after one refused connection — a container restart would take
# the device edge or the dashboard offline for longer than the restart itself.
upstream ai_pin_revival_device_edge {
    server @@REVIVAL_DEVICE_EDGE_BACKEND@@ max_fails=0;
}

upstream ai_pin_revival_local_tls {
    server @@REVIVAL_LOCAL_TLS_BACKEND@@ max_fails=0;
}

server {
    listen 443;
    listen [::]:443;

    ssl_preread on;
    proxy_pass $ai_pin_revival_443_backend;

    proxy_connect_timeout 10s;
    # proxy_timeout is an IDLE timeout, and idleness is the normal state of the
    # push plane: humane.pushrelay.PushRelayService/Subscribe is a server stream
    # Envoy routes with `timeout: 0s` precisely because it may contain nothing for a
    # long time. The 180s used by the internal :8443 passthrough would tear that
    # subscription down every three minutes and the device would read it as a
    # transport fault, so this listener holds a session open for an hour.
    proxy_timeout 1h;

    # One line per session in the access log; the error log stays at `warn` so it
    # holds refused upstreams and nothing else. `info` here would add two lines
    # per connection, and this port is publicly scanned around the clock on a
    # host whose disk is the scarce resource — the access log already answers
    # every question this plane raises.
    access_log /var/log/nginx/ai-pin-revival-device-edge.log ai_pin_revival_device_edge;
    error_log /var/log/nginx/ai-pin-revival-device-edge.error.log warn;
}
