# /etc/penumbra/center-bridge.env
#
# Runtime configuration for penumbra-center-bridge.service.
# Owned by root, readable by the service user only (chmod 640, chown root:anders).
# The ticket is the sole credential for reaching the Pin — treat this file
# like a password.

# The Pin's EndpointTicket, from `GET /api/iroh/ticket` on the Pin once it runs
# a `--features iroh` build with `iroh_remote_center_enabled = true`.
# Leave empty until then; do NOT enable the service with an empty ticket.
PIN_TICKET=

# Loopback port the bridge serves Center on (reached via `ssh -L`).
BRIDGE_PORT=18080

# Remote protocol generation; must match the Pin's connector generation.
PIN_GENERATION=1
