{
  "uid": "carry-assistant",
  "title": "Carry — Assistant & Workloads",
  "tags": ["carry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Assistant turns by outcome (per 5m)",
      "description": "The wearer-answer signal. 'answered' and 'device_action' are successes; 'deadline', 'no_answer', 'too_many_actions' are turns the wearer felt as failure.",
      "datasource": { "type": "prometheus", "uid": "carry-prometheus" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(carry_assistant_turns_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 70 }, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "deadline" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "no_answer" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "answered" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Answered share (1h)",
      "description": "Fraction of turns that ended in a spoken answer or a device action, over the last hour.",
      "datasource": { "type": "prometheus", "uid": "carry-prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(carry_assistant_turns_total{outcome=~\"answered|device_action\"}[1h])) / clamp_min(sum(increase(carry_assistant_turns_total[1h])), 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "green", "value": 0.95 } ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Model round-trip latency (p50 / p95)",
      "description": "Model steps dominate turn time; this is where a slow turn comes from.",
      "datasource": { "type": "prometheus", "uid": "carry-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (rate(carry_model_latency_seconds_bucket[10m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(carry_model_latency_seconds_bucket[10m])))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "gRPC handler latency p95 by method",
      "datasource": { "type": "prometheus", "uid": "carry-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, method) (rate(carry_rpc_duration_seconds_bucket[10m])))", "legendFormat": "{{method}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Server tool calls by tool (per 5m)",
      "datasource": { "type": "prometheus", "uid": "carry-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "targets": [
        { "refId": "A", "expr": "sum by (tool) (increase(carry_assistant_tool_calls_total[5m]))", "legendFormat": "{{tool}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errors by kind (per 5m)",
      "datasource": { "type": "prometheus", "uid": "carry-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "targets": [
        { "refId": "A", "expr": "sum by (kind) (increase(carry_errors_total[5m]))", "legendFormat": "{{kind}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] }
    }
  ]
}
