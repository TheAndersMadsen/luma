class AiPinRevival < Formula
  desc "Self-hosted Center, Cosmos, and AI Pin compatibility workspace"
  homepage "@@HOMEPAGE@@"
  url "@@URL@@"
  version "@@VERSION@@"
  sha256 "@@SHA256@@"

  depends_on "node@22"

  def install
    libexec.install Dir["*"]
    libexec.install ".dockerignore", ".editorconfig", ".env.example", ".gitignore"
    bin.write_env_script libexec/"revival", PATH: "#{Formula["node@22"].opt_bin}:$PATH"
  end

  def caveats
    <<~EOS
      The complete immutable product payload is installed under:
        #{libexec}

      Running the local stack requires Docker Desktop or another compatible
      Docker Engine with Compose. Device operations have separate signing,
      exact-target, and physical acceptance requirements.
    EOS
  end

  test do
    assert_match "Ai Pin Revival", shell_output("#{bin}/revival --help")
  end
end
