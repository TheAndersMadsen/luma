<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network for the owner's Cosmos only, plus a foreground service that keeps the
         approved session joined while the screen is off. No microphone, overlay or
         accessibility permission. The notification-listener component below holds no
         permission until the owner grants it in the television's own settings, and it is
         the only way playback can be observed rather than assumed. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- One APK serves the Pixel and the Shield; the runtime platform is reported as
         android_tv on leanback devices so routing hints can name the TV. -->
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <!-- To name the app whose screen text the owner attaches, and to resolve exactly the
         four things the owner's own device-action policy can ask this device to do. -->
    <queries>
        <intent><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent>
        <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="https"/></intent>
        <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="geo"/></intent>
        <intent><action android:name="android.intent.action.VIEW"/><data android:scheme="google.navigation"/></intent>
        <intent><action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH"/></intent>
    </queries>
    <application android:name=".CosmosApplication" android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:banner="@drawable/cosmos_tv_banner"
        android:theme="@style/Theme.Cosmos" android:allowBackup="false" android:supportsRtl="true"
        android:extractNativeLibs="false">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
        </activity>
        <!-- The assistant role: the session receives the visible text of the current screen
             on request and shows the same panel as the activity below. No hotword, no audio;
             the recognition service exists only because the role requires one and refuses. -->
        <service android:name=".assist.CosmosInteractionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" android:label="@string/app_name">
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService"/></intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/voice_interaction"/>
        </service>
        <service android:name=".assist.CosmosSessionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"/>
        <service android:name=".assist.CosmosRecognitionService" android:exported="true" android:label="@string/app_name">
            <intent-filter><action android:name="android.speech.RecognitionService"/></intent-filter>
        </service>
        <!-- The fallback panel for devices that grant the assistant role to an activity: it never sees the screen. -->
        <activity android:name=".AssistActivity" android:exported="true"
            android:theme="@style/Theme.Cosmos.Overlay" android:excludeFromRecents="true" android:launchMode="singleInstance"
            android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.ASSIST"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
        </activity>
        <!-- Runs from Connect until Disconnect so the joined room survives the screen turning off.
             It owns nothing but the quiet notification; the connection lives in the application. -->
        <service android:name=".SessionService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the owner's approved Cosmos surface connected"/>
        </service>
        <!-- The owner enables this in the television's settings so Cosmos may read active
             media sessions. It reads no notification and posts nothing; it exists so a
             play command can report observed playback instead of claiming it. -->
        <service android:name=".action.PlaybackListenerService" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:label="@string/app_name">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService"/></intent-filter>
        </service>
        <receiver android:name=".SessionService$DisconnectReceiver" android:exported="false"/>
    </application>
</manifest>
