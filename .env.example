# Luma runtime configuration template.
#
# `./luma init` copies this file to the external secrets directory at mode
# 0600. Never run from this source template and never add credentials here.
# Explore one stage at a time with `luma config template --group GROUP` and
# validate the protected result with `luma config check`.
#
# Choose external locations with LUMA_CONFIG_DIR, LUMA_SECRETS_DIR,
# LUMA_DATA_DIR, and LUMA_BUILD_DIR before running the
# CLI. Directory controls do not belong in this secret-bearing file.

# ---------------------------------------------------------------------------
# Local product: enough to run Center and Cosmos on loopback
# ---------------------------------------------------------------------------

LUMA_CONFIG_VERSION=1
LUMA_RELEASE_ID=local
LUMA_RELEASE_VERSION=
# The rest of an operator release's identity, which production setup writes
# and Center shows as this server's version. Source checkouts leave them blank.
LUMA_RELEASE_TAG=
LUMA_PIN_RELEASE_VERSION=
LUMA_PIN_RELEASE_VERSION_CODE=
LUMA_RELEASE_PUBLISHED_AT=
# Production operator releases stamp an immutable OCI Compose application here.
# Source checkouts leave it blank. Never use a mutable tag for deployment.
LUMA_COMPOSE_APPLICATION=
LUMA_CENTER_PORT=4000

# `development-insecure` is accepted only on loopback. Production requires an
# edge-authenticated mode.
COSMOS_AUTH_MODE=development-insecure

# Local identity is optional. `luma init` creates a sanitized external realm
# with no wearer accounts and random bootstrap credentials, but leaves the
# profile disabled until you opt in.
LUMA_IDENTITY_ENABLED=false

# ---------------------------------------------------------------------------
# Production operator: public origin, identity, access, and protected state
# ---------------------------------------------------------------------------

LUMA_PUBLIC_DOMAIN=
LUMA_PUBLIC_ORIGIN=
LUMA_ACME_EMAIL=
# Optional comma-separated existing Docker networks Traefik joins so the
# owner's traefik-extra.json routes can reach them (README: other hostnames).
LUMA_TRAEFIK_EXTRA_NETWORKS=
# The Center origin whose /api/version this server asks for newer releases
# (`setup production --update-source`), and whether it installs them itself
# at night (`--auto-updates on|off`, README "Update Luma").
LUMA_UPDATE_SOURCE=
LUMA_AUTO_UPDATES=
COSMOS_OIDC_ISSUER=
COSMOS_CAPTURE_SHARE_BASE_URL=
COSMOS_ONBOARDING_ENDPOINT=https://onboarding.cosmos.humane.cloud
# Public HTTPS origin whose /capture/* path reaches the ai-bus HTTP service.
# This deployment-specific ingress name cannot be inferred from Center or the
# device gRPC edge, so production preflight requires the operator to set it.
COSMOS_CAPTURE_UPLOAD_BASE_URL=

# `luma init` creates one PostgreSQL password and the matching in-stack URL,
# then preserves both on later runs. Set both explicitly when using an external
# database. Grafana receives a separate generated administrator password.
COSMOS_PG_PASSWORD=
COSMOS_DATABASE_URL=
GRAFANA_ADMIN_PASSWORD=

# Independent random values. `luma init` fills blank generated fields once
# and never replaces a nonblank value.
COSMOS_EDGE_TOKEN=
AUTH_SESSION_SECRET=
LUMA_MUSIC_GATEWAY_ORIGIN=
# Register an official TIDAL application before enabling TIDAL in Center.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
# Defaults to the minimum user, collection and playback scopes when blank.
TIDAL_SCOPES=
# Optional ISO 3166-1 alpha-2 override. When blank, Center reads the connected TIDAL user's country.
TIDAL_COUNTRY_CODE=
# Apple remains unavailable until both a developer token and official playback runtime exist.
APPLE_MUSIC_DEVELOPER_TOKEN=
COSMOS_SHARE_TOKEN_SECRET=
COSMOS_ADMIN_TOKEN=

# Production uses the fixed internal Keycloak service and realm.
KEYCLOAK_CLIENT_ID=center
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SCOPES=openid email profile
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# `luma setup production` creates the first operator and places its
# one-time readable handoff in the protected production configuration directory.
LUMA_FIRST_OPERATOR_EMAIL=
LUMA_FIRST_OPERATOR_ID=

# Operator access to infrastructure-only Center routes.
COSMOS_OPERATOR_EMAILS=

# Scope channel keys to the authenticated wearer.
COSMOS_KID_SCOPE=enforce

# `luma init` generates and preserves this private search session secret.
# Leave it blank in source.
SEARXNG_SECRET=
COSMOS_SEARXNG_BASE_URL=

# Core is implicit. Optional services are selected by setup from this exact
# comma-separated set: pin,search,spotify,observability.
COMPOSE_PROFILES=

# ---------------------------------------------------------------------------
# Optional providers: configure only the capability you intend to enable
# ---------------------------------------------------------------------------

COSMOS_MUSICBRAINZ_BASE_URL=https://musicbrainz.org
COSMOS_SHOPPING_VISUAL_SEARCH_URL=
COSMOS_SHOPPING_ALLOWED_HOSTS=
COSMOS_SHOPPING_API_KEY=

# Headless bootstrap only. Center derives remote-speech readiness from the
# saved Cosmos key and region. Leave this false for dashboard-managed setup.
COSMOS_REMOTE_TTS_ENABLED=false
COSMOS_AZURE_SPEECH_KEY=
COSMOS_AZURE_SPEECH_REGION=
COSMOS_AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural

COSMOS_LLM_BASE_URL=
COSMOS_LLM_API_KEY=
COSMOS_LLM_MODEL=
COSMOS_LLM_REASONING_EFFORT=
COSMOS_LLM_MAX_TOKENS=512
COSMOS_SERPAPI_KEY=
COSMOS_GOOGLE_MAPS_KEY=
COSMOS_PIRATE_WEATHER_KEY=
COSMOS_WOLFRAM_APP_ID=
COSMOS_PPLX_API_KEY=
COSMOS_PPLX_MODEL=
COSMOS_OPEN_FOOD_FACTS_USERNAME=
COSMOS_OPEN_FOOD_FACTS_PASSWORD=

# ---------------------------------------------------------------------------
# Pin: pairing, enrollment, and DeviceUser identity
# ---------------------------------------------------------------------------

# Production-only native Spotify pairing. The deployment owns the adapter
# address and token path. Configure only the paired owner and device.
LUMA_SPOTIFY_ADAPTER_URL=
LUMA_DEVICE_EDGE_IPV4=

# The account an unpaired Pin enrolls into. Each account's Pin passcode is set
# by its owner in Center (Settings → Pin passcode). The deployment holds none.
# `init` generates the independent private 32-byte OPAQUE seed.
COSMOS_ENROLLMENT_USER_ID=
COSMOS_OPAQUE_SEED=
