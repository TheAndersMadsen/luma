# Ai Pin Revival runtime configuration template.
#
# `./revival init` copies this template to the external secrets directory and
# sets mode 0600. Never run the stack from this file and never add credentials
# here. Select external locations with REVIVAL_CONFIG_DIR,
# REVIVAL_SECRETS_DIR, REVIVAL_DATA_DIR, REVIVAL_BUILD_DIR, and
# REVIVAL_BACKUP_DIR before running the CLI; those directory controls do not
# belong in this secret-bearing file.

REVIVAL_CONFIG_VERSION=1
REVIVAL_RELEASE_ID=local
REVIVAL_CENTER_PORT=4000
REVIVAL_PUBLIC_ORIGIN=https://center.andersmadsen.dk
CARRY_OIDC_ISSUER=https://center.andersmadsen.dk/realms/humane
CARRY_CAPTURE_SHARE_BASE_URL=https://center.andersmadsen.dk
CARRY_MUSICBRAINZ_BASE_URL=https://musicbrainz.org
CARRY_SHOPPING_VISUAL_SEARCH_URL=
CARRY_SHOPPING_ALLOWED_HOSTS=
CARRY_SHOPPING_API_KEY=

# Local evaluation may use development-insecure only on loopback. Production
# is rejected unless this is edge-authenticated.
REVIVAL_AUTH_MODE=development-insecure
REVIVAL_EDGE_TOKEN=

# Independent random values. `revival init` fills only blank fields and never
# replaces a nonblank value.
AUTH_SESSION_SECRET=
REVIVAL_SHARE_TOKEN_SECRET=
REVIVAL_CENTER_PROJECTION_TOKEN=
REVIVAL_ADMIN_TOKEN=

# Azure AI Speech. Enabling this switch requires a matching key, resource
# region, and voice. The deployment keeps the key scoped to Cosmos's AI Bus.
REVIVAL_REMOTE_TTS_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural

# Optional production-only Pin-native Spotify adapter. Setup pairs the Pin with
# the official Spotify app; this stack does not request cloud Spotify
# credentials. Deployment generates the external adapter token file. Configure
# all four together only after Pin Bridge pairing has produced an owner subject
# and resolved the exact owned device. No identifier format is assumed here.
REVIVAL_SPOTIFY_ADAPTER_URL=
REVIVAL_SPOTIFY_ADAPTER_TOKEN_FILE=
REVIVAL_PIN_BRIDGE_OWNER_SUB=
REVIVAL_PIN_BRIDGE_DEVICE_ID=

# Identity is optional for a loopback development stack. `revival init` creates
# a sanitized external realm with an empty wearer list, a random confidential
# client secret, and random bootstrap-admin credentials. Identity remains off
# until explicitly enabled; create the first wearer through the local Keycloak
# admin console instead of embedding a shared sample password. Production
# preserves the reviewed existing realm and client rather than importing this
# local bootstrap realm.
REVIVAL_IDENTITY_ENABLED=false
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=humane
KEYCLOAK_CLIENT_ID=center
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SCOPES=openid email profile
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Device enrollment remains off while both fields are blank. The four-digit
# value is a short-lived enrollment secret, not a reusable wearer password.
# `init` generates the private 32-byte OPAQUE server seed independently; it is
# required before enrollment can be enabled.
REVIVAL_ENROLLMENT_PINCODE=
REVIVAL_ENROLLMENT_USER_ID=
REVIVAL_OPAQUE_SEED=
REVIVAL_DUC_CA_CERT=/run/secrets/duc_ca_cert
REVIVAL_DUC_CA_KEY=/run/secrets/duc_ca_key

# Operator access to infrastructure-only Center routes.
REVIVAL_OPERATOR_EMAILS=

# Compatibility environment aliases consumed by existing Pin wire adapters.
# They are not product names or preferred operator configuration. Leave these
# blank in new installations; `revival` maps the canonical values above at
# process launch. Existing protected deployments may retain them while they
# are migrated without rotating identity or state.
CARRY_AUTH_MODE=
CARRY_EDGE_TOKEN=
CARRY_SHARE_TOKEN_SECRET=
CARRY_CENTER_PROJECTION_TOKEN=
CARRY_ADMIN_TOKEN=
CARRY_OPAQUE_SEED=
CARRY_REMOTE_TTS_ENABLED=
CARRY_AZURE_SPEECH_KEY=
CARRY_AZURE_SPEECH_REGION=
CARRY_AZURE_SPEECH_VOICE=
CARRY_ENROLLMENT_PINCODE=
CARRY_ENROLLMENT_USER_ID=
CARRY_DUC_CA_CERT=
CARRY_DUC_CA_KEY=
CARRY_OPERATOR_EMAILS=

# Whether a key operation naming ANOTHER wearer's kid is refused (`enforce`) or
# only reported (`audit`, the default). The comparison runs either way and every
# foreign kid produces a warn line plus a `carry_kid_scope_foreign_total` counter
# sample; the mode decides whether the RPC also fails. Blank means `audit`, and
# the AI-bus workload says so at `warn` on every boot.
#
# Do NOT set this to `enforce` on a deployment whose stored channel keys were
# minted under a retired user id — the wearer's own kids then read as foreign,
# and a refusal on RequestKeys strands the device. See the "Principal scoping"
# notes in cosmos/crates/cosmos/src/services/public_privacy.rs.
CARRY_KID_SCOPE=

# Production's private search service has one independent session secret. The
# guarded deploy engine generates it when absent and preserves it across later
# releases; leave it blank in source and local development templates.
SEARXNG_SECRET=

# Provider-specific Cosmos compatibility variables. These remain optional and
# belong only in the protected runtime file when their capability is enabled.
CARRY_LLM_BASE_URL=
CARRY_LLM_API_KEY=
CARRY_OPENROUTER_API_KEY=
CARRY_LLM_MODEL=
CARRY_LLM_REASONING_EFFORT=
CARRY_LLM_MAX_TOKENS=512
CARRY_VISION_MODEL=
CARRY_INTERSTITIAL_BASE_URL=
CARRY_INTERSTITIAL_MODEL=
CARRY_INTERSTITIAL_API_KEY=
CARRY_LOCAL_MODEL_NETWORK=humane-carry-clone_carry-local
CARRY_SERPAPI_KEY=
CARRY_GOOGLE_MAPS_KEY=
CARRY_PIRATE_WEATHER_KEY=
CARRY_WOLFRAM_APP_ID=
CARRY_PPLX_API_KEY=
CARRY_PPLX_MODEL=
