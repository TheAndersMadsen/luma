# Ai Pin Revival runtime configuration template.
#
# `./revival init` copies this file to the external secrets directory at mode
# 0600. Never run from this source template and never add credentials here.
# Explore one stage at a time with `revival config template --group GROUP` and
# validate the protected result with `revival config check`.
#
# Choose external locations with REVIVAL_CONFIG_DIR, REVIVAL_SECRETS_DIR,
# REVIVAL_DATA_DIR, REVIVAL_BUILD_DIR, and REVIVAL_BACKUP_DIR before running the
# CLI. Directory controls do not belong in this secret-bearing file.

# ---------------------------------------------------------------------------
# Local product: enough to run Center and Cosmos on loopback
# ---------------------------------------------------------------------------

REVIVAL_CONFIG_VERSION=1
REVIVAL_RELEASE_ID=local
REVIVAL_CENTER_PORT=4000

# `development-insecure` is accepted only on loopback. Production requires an
# edge-authenticated mode.
REVIVAL_AUTH_MODE=development-insecure

# Local identity is optional. `revival init` creates a sanitized external realm
# with no wearer accounts and random bootstrap credentials, but leaves the
# profile disabled until you opt in.
REVIVAL_IDENTITY_ENABLED=false

# Optional network used by a separately operated local model.
CARRY_LOCAL_MODEL_NETWORK=humane-carry-clone_carry-local

# ---------------------------------------------------------------------------
# Production operator: public origin, identity, access, and protected state
# ---------------------------------------------------------------------------

REVIVAL_PUBLIC_ORIGIN=https://center.andersmadsen.dk
CARRY_OIDC_ISSUER=https://center.andersmadsen.dk/realms/humane
CARRY_CAPTURE_SHARE_BASE_URL=https://center.andersmadsen.dk

# Independent random values. `revival init` fills blank generated fields once
# and never replaces a nonblank value.
REVIVAL_EDGE_TOKEN=
AUTH_SESSION_SECRET=
REVIVAL_SHARE_TOKEN_SECRET=
REVIVAL_CENTER_PROJECTION_TOKEN=
REVIVAL_ADMIN_TOKEN=

# Production preserves the reviewed existing realm and client instead of
# importing the local bootstrap realm.
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=humane
KEYCLOAK_CLIENT_ID=center
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SCOPES=openid email profile
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=

# Operator access to infrastructure-only Center routes.
REVIVAL_OPERATOR_EMAILS=

# `audit` is the safe blank/default behavior. Do not set `enforce` when stored
# channel keys were minted under a retired user id; the wearer's own keys then
# read as foreign and RequestKeys can strand the device. See principal scoping
# in cosmos/crates/cosmos/src/services/public_privacy.rs.
CARRY_KID_SCOPE=

# The guarded deploy engine generates and preserves this private search session
# secret when absent. Leave it blank in source and local development.
SEARXNG_SECRET=

# ---------------------------------------------------------------------------
# Optional providers: configure only the capability you intend to enable
# ---------------------------------------------------------------------------

CARRY_MUSICBRAINZ_BASE_URL=https://musicbrainz.org
CARRY_SHOPPING_VISUAL_SEARCH_URL=
CARRY_SHOPPING_ALLOWED_HOSTS=
CARRY_SHOPPING_API_KEY=

# Remote TTS requires the switch, key, region, and selected voice together.
REVIVAL_REMOTE_TTS_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural

CARRY_LLM_BASE_URL=
CARRY_LLM_API_KEY=
CARRY_OPENROUTER_API_KEY=
CARRY_LLM_MODEL=
CARRY_LLM_REASONING_EFFORT=
CARRY_LLM_MAX_TOKENS=512
CARRY_VISION_MODEL=
CARRY_INTERSTITIAL_BASE_URL=
CARRY_INTERSTITIAL_MODEL=
CARRY_INTERSTITIAL_API_KEY=
CARRY_SERPAPI_KEY=
CARRY_GOOGLE_MAPS_KEY=
CARRY_PIRATE_WEATHER_KEY=
CARRY_WOLFRAM_APP_ID=
CARRY_PPLX_API_KEY=
CARRY_PPLX_MODEL=

# ---------------------------------------------------------------------------
# Pin: pairing, enrollment, and DeviceUser identity
# ---------------------------------------------------------------------------

# Production-only native Spotify pairing. Configure all four together only
# after the official Spotify app has paired and Pin Bridge has resolved the
# exact owner and device. The deployment creates the external adapter token.
REVIVAL_SPOTIFY_ADAPTER_URL=
REVIVAL_SPOTIFY_ADAPTER_TOKEN_FILE=
REVIVAL_PIN_BRIDGE_OWNER_SUB=
REVIVAL_PIN_BRIDGE_DEVICE_ID=

# Enrollment remains off while pincode and user id are blank. The four digits
# are short-lived enrollment material, not a reusable wearer password. `init`
# generates the independent private 32-byte OPAQUE seed.
REVIVAL_ENROLLMENT_PINCODE=
REVIVAL_ENROLLMENT_USER_ID=
REVIVAL_OPAQUE_SEED=

# These are container mount paths, not PEM contents. Use `revival pki import
# device-user` or `revival pki init device-user`; never paste private keys here.
REVIVAL_DUC_CA_CERT=/run/secrets/duc_ca_cert
REVIVAL_DUC_CA_KEY=/run/secrets/duc_ca_key

# ---------------------------------------------------------------------------
# Compatibility aliases: existing deployments only
# ---------------------------------------------------------------------------

# New installations use the canonical settings above. `revival` maps these
# historical Pin-wire adapter names at launch. Leave them blank unless migrating
# an existing protected deployment; `revival config check` rejects disagreement.
CARRY_AUTH_MODE=
CARRY_EDGE_TOKEN=
CARRY_SHARE_TOKEN_SECRET=
CARRY_CENTER_PROJECTION_TOKEN=
CARRY_ADMIN_TOKEN=
CARRY_OPAQUE_SEED=
CARRY_REMOTE_TTS_ENABLED=
CARRY_AZURE_SPEECH_KEY=
CARRY_AZURE_SPEECH_REGION=
CARRY_AZURE_SPEECH_VOICE=
CARRY_ENROLLMENT_PINCODE=
CARRY_ENROLLMENT_USER_ID=
CARRY_DUC_CA_CERT=
CARRY_DUC_CA_KEY=
CARRY_OPERATOR_EMAILS=
