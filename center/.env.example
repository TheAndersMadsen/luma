# Cosmos is a service topology: one process per workload.
# In production Istio routes by service name. Locally each gets its own port.
COSMOS_ENDPOINT_AI_BUS=127.0.0.1:50051
COSMOS_ENDPOINT_NOTABLE_EVENTS=127.0.0.1:50052
COSMOS_ENDPOINT_CONTACTS=127.0.0.1:50053
COSMOS_ENDPOINT_ACCOUNT=127.0.0.1:50054

# Fallback for any service without a workload-specific endpoint.
COSMOS_GRPC_ENDPOINT=127.0.0.1:50051

# development-insecure synthesises a principal, so no metadata is needed.
# Under edge-authenticated, forward one:
# COSMOS_PRINCIPAL=<principal>
# COSMOS_GRPC_TLS=1

# Cosmos's REST web API (its AI Bus workload with COSMOS_DEMO_ENABLED=1).
# This is the surface .Center itself used: /capture/captures, /capture/memories, /notes
COSMOS_WEBAPI_BASE_URL=http://127.0.0.1:8081
# Optional delivery evidence. In Compose this is the feature-flags workload's
# internal metrics listener. Center uses only the aggregate successful RPC count.
COSMOS_FEATURE_FLAGS_METRICS_URL=http://feature-flags:18080

# ── Authentication (Keycloak / OIDC) ─────────────────────────────────────────
# Compose owns Center's internal Keycloak URL and `humane` realm. A direct
# `next dev` stays open unless its process environment enables Keycloak. When
# auth is enabled, AUTH_SESSION_SECRET is REQUIRED, the app fails closed
# without it rather than signing sessions with a public dev key.
# KEYCLOAK_CLIENT_ID=center
# KEYCLOAK_CLIENT_SECRET=<confidential-client-secret>
# AUTH_SESSION_SECRET=<random 32+ byte hex>       # REQUIRED when Keycloak is set
# Operator console access defaults to denied. Grant the `cosmos-operator` realm
# role or the same client role on KEYCLOAK_CLIENT_ID. For a self-hosted bootstrap
# only, an exact comma-separated email allowlist can grant the same boolean claim:
# COSMOS_OPERATOR_EMAILS=operator@example.com
# LUMA_RELEASE_ID=<immutable deployment revision shown by /api/version>
# LUMA_PUBLIC_ORIGIN=https://center.example.com
LUMA_ENVIRONMENT=development
# KEYCLOAK_SCOPES=openid email profile            # widen once the realm defines service scopes

# ── Pin-native Spotify bridge ────────────────────────────────────────────────
# Center never handles Spotify credentials. Production Compose owns the
# purpose-scoped adapter endpoint and token mount.
# General Spotify control-route timeout. Provider playback uses a fixed,
# route-specific nested deadline ladder. Do not raise this value for playback.
# LUMA_SPOTIFY_ADAPTER_TIMEOUT_MS=10000
# Local development fallback only. Production should mount the token file:
# LUMA_SPOTIFY_ADAPTER_TOKEN=<random 32+ character purpose-scoped token>

# ── Pin console over USB ─────────────────────────────────────────────────────
# The Pin console runs in the browser over WebUSB, so it needs no network
# configuration. Its single outbound call, signing the device's ADB AUTH
# challenge, is proxied server-side by /api/pin/adb/sign so that
# `connect-src 'self'` never has to be widened. Both values are optional and
# already correct by default. Set them only to point at your own signer.
# LUMA_PIN_ADB_SIGNER_URL=https://adb.penumbraos.workers.dev
# LUMA_PIN_ADB_SIGNER_TIMEOUT_MS=10000
