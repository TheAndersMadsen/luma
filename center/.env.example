# Cosmos is a service topology: one process per workload.
# In production Istio routes by service name; locally each gets its own port.
COSMOS_ENDPOINT_AI_BUS=127.0.0.1:50051
COSMOS_ENDPOINT_NOTABLE_EVENTS=127.0.0.1:50052
COSMOS_ENDPOINT_CONTACTS=127.0.0.1:50053
COSMOS_ENDPOINT_ACCOUNT=127.0.0.1:50054

# Fallback for any service without a workload-specific endpoint.
COSMOS_GRPC_ENDPOINT=127.0.0.1:50051

# Where the shared wire contracts (.proto) are read from. LEAVE THIS UNSET for
# `npm run dev` and `npm test`: the default already resolves to ../contracts/wire
# relative to this package, which is where they live in this repo. The container
# image is the only thing that overrides it (center/Dockerfile sets
# COSMOS_CONTRACTS_DIR=/app/contracts, the path the wire_contracts build stage
# copies them to). Set it only if you keep the contracts somewhere else.
#
# Getting this wrong is not quiet: protoLoader throws inside the first gRPC call
# and every pane that reads a workload — contacts, account details, my-data, note
# creation, memory delete — renders the wording reserved for a backend outage. If
# you see that on a dev machine whose backend is up, check this path first.
# COSMOS_CONTRACTS_DIR=../contracts/wire

# development-insecure synthesises a principal, so no metadata is needed.
# Under edge-authenticated, forward one:
# COSMOS_PRINCIPAL=<principal>
# COSMOS_GRPC_TLS=1

# Cosmos's REST web API (its AI Bus workload with COSMOS_DEMO_ENABLED=1).
# This is the surface .Center itself used: /capture/captures, /capture/memories, /notes
COSMOS_WEBAPI_BASE_URL=http://127.0.0.1:8081
# Optional delivery evidence. In Compose this is the feature-flags workload's
# internal metrics listener; Center uses only the aggregate successful RPC count.
COSMOS_FEATURE_FLAGS_METRICS_URL=http://feature-flags:18080

# ── Authentication (Keycloak / OIDC) ─────────────────────────────────────────
# Auth turns ON exactly when KEYCLOAK_BASE_URL is set (local `next dev` with it
# unset stays open). When it IS set, AUTH_SESSION_SECRET is REQUIRED — the app
# fails closed without it rather than signing sessions with a public dev key.
# KEYCLOAK_BASE_URL=http://cosmos-keycloak:8080   # server-side (internal) Keycloak
# KEYCLOAK_REALM=humane
# KEYCLOAK_CLIENT_ID=center
# KEYCLOAK_CLIENT_SECRET=<confidential-client-secret>
# AUTH_SESSION_SECRET=<random 32+ byte hex>       # REQUIRED when Keycloak is set
# Operator console access defaults to denied. Grant the `carry-operator` realm
# role or the same client role on KEYCLOAK_CLIENT_ID. For a self-hosted bootstrap
# only, an exact comma-separated email allowlist can grant the same boolean claim:
# COSMOS_OPERATOR_EMAILS=operator@example.com
# COSMOS_SHARE_TOKEN_SECRET=<different random 32+ byte secret>
# COSMOS_CENTER_PROJECTION_TOKEN=<purpose-scoped secret shared only with Cosmos webapi>
# COSMOS_CHANNEL_KEY_FILE=/data/channel-key.json   # persistent, readable by 1000:1001
# CARRY_CHANNEL_KEY_FILE=/data/channel-key.json    # legacy alias; if both are set they must match
# REVIVAL_RELEASE_ID=<immutable deployment revision shown by /api/version>
# KEYCLOAK_SCOPES=openid email profile            # widen once the realm defines service scopes

# ── Pin-native Spotify bridge ────────────────────────────────────────────────
# Center never handles Spotify credentials. It controls the paired Pin's local
# Spotify Connect runtime through the purpose-scoped adapter only.
# REVIVAL_SPOTIFY_ADAPTER_URL=http://10.0.7.1:18081
# REVIVAL_SPOTIFY_ADAPTER_TOKEN_FILE=/run/secrets/spotify_adapter_token
# REVIVAL_PIN_BRIDGE_OWNER_SUB=<exact Keycloak subject paired to this one Pin>
# REVIVAL_PIN_BRIDGE_DEVICE_ID=<exact device_id targeted by the pinned iroh bridge>
# REVIVAL_SPOTIFY_ADAPTER_TIMEOUT_MS=5000
# Local development fallback only; production should mount the token file:
# REVIVAL_SPOTIFY_ADAPTER_TOKEN=<random 32+ character purpose-scoped token>

# ── Pin console over USB ─────────────────────────────────────────────────────
# The Pin console runs in the browser over WebUSB, so it needs no network
# configuration. Its single outbound call — signing the device's ADB AUTH
# challenge — is proxied server-side by /api/pin/adb/sign so that
# `connect-src 'self'` never has to be widened. Both values are optional and
# already correct by default; set them only to point at your own signer.
# REVIVAL_PIN_ADB_SIGNER_URL=https://adb.penumbraos.workers.dev
# REVIVAL_PIN_ADB_SIGNER_TIMEOUT_MS=10000
