{
  "name": "ai-pin-revival-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0 -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --experimental-strip-types --test verify/*.test.mjs",
    "test:ui": "vitest run",
    "test:all": "npm run typecheck && npm test && npm run test:ui",
    "test:share": "node --no-warnings --experimental-strip-types --test verify/share-token.test.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@tanstack/react-query": "^5.62.0",
    "@xterm/xterm": "^6.0.0",
    "@yume-chan/adb": "^2.6.0",
    "@yume-chan/adb-daemon-webusb": "^2.3.2",
    "@yume-chan/stream-extra": "^2.5.3",
    "flatbuffers": "^25.9.23",
    "jose": "^5.9.6",
    "next": "^15.5.23",
    "qrcode.react": "^4.2.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "youtubei.js": "18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.0.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
