{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-pin-revival.invalid/contracts/operator-setup.schema.json",
  "title": "Ai Pin Revival operator setup contract",
  "description": "Versioned, data-only setup, command, safety, journey, and configuration metadata shared by operator surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "contractVersion",
    "mutationPolicies",
    "commands",
    "journeys",
    "settings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "operator-setup" },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "mutationPolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read-only", "local-mutation", "remote-mutation", "device-mutation"],
      "properties": {
        "read-only": { "$ref": "#/$defs/unconfirmedPolicy" },
        "local-mutation": { "$ref": "#/$defs/unconfirmedPolicy" },
        "remote-mutation": { "$ref": "#/$defs/confirmedPolicy" },
        "device-mutation": { "$ref": "#/$defs/devicePolicy" }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "journeys": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/journey" }
    },
    "settings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/setting" }
    }
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmationRequired", "exactSerialRequired"],
      "properties": {
        "confirmationRequired": { "type": "boolean" },
        "exactSerialRequired": { "type": "boolean" }
      }
    },
    "unconfirmedPolicy": {
      "allOf": [
        { "$ref": "#/$defs/policy" },
        {
          "properties": {
            "confirmationRequired": { "const": false },
            "exactSerialRequired": { "const": false }
          }
        }
      ]
    },
    "confirmedPolicy": {
      "allOf": [
        { "$ref": "#/$defs/policy" },
        {
          "properties": {
            "confirmationRequired": { "const": true },
            "exactSerialRequired": { "const": false }
          }
        }
      ]
    },
    "devicePolicy": {
      "allOf": [
        { "$ref": "#/$defs/policy" },
        {
          "properties": {
            "confirmationRequired": { "const": true },
            "exactSerialRequired": { "const": true }
          }
        }
      ]
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?:--?[a-z][a-z0-9-]*|[a-z][a-z0-9-]*)$"
    },
    "tokenList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/token" }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tokens",
        "aliases",
        "lifecycle",
        "effect",
        "confirmationRequired",
        "exactSerialRequired",
        "summary",
        "usage",
        "documentationAnchor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "tokens": { "$ref": "#/$defs/tokenList" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/tokenList" }
        },
        "lifecycle": { "enum": ["current", "planned"] },
        "effect": {
          "enum": ["read-only", "local-mutation", "remote-mutation", "device-mutation"]
        },
        "confirmationRequired": { "type": "boolean" },
        "exactSerialRequired": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "usage": { "type": "string", "minLength": 1, "maxLength": 180 },
        "documentationAnchor": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:README\\.md|CONTRIBUTING\\.md|docs/[A-Za-z0-9._/-]+\\.md)#[a-z0-9][a-z0-9-]*$"
            },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "effect": { "const": "remote-mutation" } }, "required": ["effect"] },
          "then": {
            "properties": {
              "confirmationRequired": { "const": true },
              "exactSerialRequired": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "effect": { "const": "device-mutation" } }, "required": ["effect"] },
          "then": {
            "properties": {
              "confirmationRequired": { "const": true },
              "exactSerialRequired": { "const": true }
            }
          }
        }
      ]
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "commandIds", "steps"],
      "properties": {
        "id": { "enum": ["local", "contributor", "production", "pin"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "commandIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/journeyStep" }
        }
      }
    },
    "journeyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "commandId",
        "centerRoute",
        "surface",
        "verification",
        "documentationAnchor"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "commandId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "centerRoute": {
          "oneOf": [
            { "type": "string", "pattern": "^/[A-Za-z0-9/_-]*$" },
            { "type": "null" }
          ]
        },
        "surface": { "enum": ["cli", "center", "manual"] },
        "verification": { "enum": ["cli", "center", "physical"] },
        "documentationAnchor": {
          "type": "string",
          "pattern": "^(?:README\\.md|CONTRIBUTING\\.md|docs/[A-Za-z0-9._/-]+\\.md)#[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "aliases", "group", "sensitivity", "home"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "group": { "enum": ["local", "production", "provider", "pin"] },
        "sensitivity": { "enum": ["operational", "identity", "secret"] },
        "home": {
          "enum": ["runtime.env", "center.env", "cosmos.env", "providers.env", "pin.env"]
        }
      }
    }
  },
  "x-runtime-invariants": [
    "Command ids and token paths are unique, including aliases.",
    "Every journey id is present once and references only declared commands.",
    "Every command meets or exceeds the safety policy selected by its effect.",
    "Every device mutation requires confirmation and an exact serial.",
    "Setting names and aliases are globally unique and contain no values.",
    "The settings name and alias union equals the names declared by .env.example.",
    "The document contains no executable shell fragments or credential values."
  ]
}
