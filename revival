#!/usr/bin/env node
'use strict';

// The stable operator entry point. Command implementations live in
// platform/cli/ — context (configuration and runtime validation), toolchain,
// stack, gates, releases, production, and pin — and this file only parses the
// command line and dispatches. Help text, exit codes, environment variables,
// and plan/confirm behavior are unchanged.

const { PRODUCT, fail, info, initialize } = require('./platform/cli/context');
const { localDoctor, stack } = require('./platform/cli/stack');
const { buildRelease, verifyRelease } = require('./platform/cli/releases');
const { releaseCheck } = require('./platform/cli/gates');
const {
  adoptProtectedConfiguration,
  deployProduction,
  deploymentScript,
  productionDoctor,
  pruneState,
  rollbackProduction,
} = require('./platform/cli/production');
const { pinCommand } = require('./platform/cli/pin');

function help() {
  info(`${PRODUCT}\n\n` +
    'Local product\n' +
    '  ./revival init\n' +
    '  ./revival doctor [production [preflight options]]\n' +
    '  ./revival stack build|up|down|status|logs|config\n' +
    '  ./revival test [--source]   VPS release gate; optionally add Pin source checks\n\n' +
    'Immutable releases\n' +
    '  ./revival release check [--source]\n' +
    '  ./revival release build [--profile vps|source] [--output DIR]\n' +
    '  ./revival release verify --archive FILE --manifest FILE [--json]\n\n' +
    'Pin host operations (no device mutation)\n' +
    '  ./revival pin doctor [--json|--verbose]\n' +
    '  ./revival pin check\n' +
    '  ./revival pin release build --version YYYY-MM-DD.N --version-code INTEGER\n' +
    '  ./revival pin release ship [--remote vps] [--confirm]   local store -> the store Center serves\n' +
    '  ./revival pin release inspect|verify|plan ...\n\n' +
    'Production operations\n' +
    '  ./revival deploy production [--dry-run] [--release-json FILE]\n' +
    '  ./revival backup [--remote vps] [--fetch [--fetch-dir DIR]] [--json]\n' +
    '  ./revival canary [--remote vps] [--crud] [--wearer-plane-optional] [--from-tree] [--json]\n' +
    '  ./revival drift [--remote vps] [--json]\n' +
    '  ./revival adopt-config [--remote vps] [--baseline all|pending|current] [--show-all]\n' +
    '                         [--confirm --reason TEXT [--expect-plan TOKEN]]\n' +
    '  ./revival prune-state [--remote vps] [--min-age-hours N] [--show-all]\n' +
    '                        [--include-incomplete] [--confirm [--expect-plan TOKEN]]\n' +
    '  ./revival rollback --deployment ID\n\n' +
    'Short local aliases: build, up, down, status, logs, config.\n' +
    // Named on every operator surface on purpose. The two CA private keys and the
    // Pin signing keystores cannot be regenerated, and every server-side backup
    // shares a disk with what it protects, so an operator who never learns this
    // flag exists has no off-host copy at all.
    '`backup --fetch` is the only copy of the irreplaceable key material that does not live on the server it protects (docs/recovery.md).\n' +
    'Rollback moves the release pointer back and restores no database; the manual restore procedure is docs/recovery.md.\n' +
    // The deadlock this exists for: a protected input legitimately changes (the
    // Pin regenerated its iroh identity, so /etc/penumbra had to be re-ticketed),
    // and then the old value fails the canary while the new one fails the drift
    // gate. Neither `deploy` nor `drift` can resolve that, and the only remaining
    // move was hand-editing a digest row with no record of it whatsoever.
    '`adopt-config` is the supported way to change a protected configuration input: it shows every differing row first,\n' +
    'says which deployment record the next deploy checks and why, and without --confirm it changes nothing.\n' +
    // Named here because the failure it prevents is invisible until it is total:
    // backups/ and releases/ only grow, nothing else in this tree removes from
    // either, and preflight refuses a deploy below 8 GiB free. An operator who
    // never learns this command exists discovers the problem as "deploys stopped
    // working" with production serving normally and no supported way to free space.
    '`prune-state` is the only thing that removes a backup or a release tree. It keeps everything a recovery path can\n' +
    'still reach — proven per item, not by count — and without --confirm it only prints the plan.\n' +
    'The Pin host commands above may build and publish external signed-release artifacts; they do not install, reset, flash, or provision a device.\n' +
    // Not listed above, and deliberately so: that section is the set of commands
    // an operator can run without a Pin at risk, and its heading has to keep
    // meaning exactly that. The one subcommand that can write to a device is
    // reached through `./revival pin`, which states what it does and does not do.
    'One `./revival pin` subcommand can write to a connected device; it plans only until it is given --confirm, and its own --help says so.\n' +
    // "publish" here means the release store on THIS host. Reading it as "the
    // server now has the release" is the exact mistake that leaves Center
    // answering 404 for /api/pin/releases/current with nothing to explain it.
    '`pin release build` publishes to the local store only; `pin release ship --confirm` is what puts it where Center serves it.\n\n' +
    'Stock Pin to provisioned device, in order: docs/operations.md#onboarding-a-pin');
}

const args = process.argv.slice(2);
const command = args.shift();

if (!command || ['help', '--help', '-h'].includes(command)) {
  help();
} else if (command === 'init') {
  try {
    initialize();
  } catch (error) {
    fail(error.message);
  }
} else if (command === 'doctor') {
  if (args[0] === 'production') {
    args.shift();
    productionDoctor(args);
  } else {
    localDoctor();
  }
} else if (command === 'stack') {
  stack(args.shift(), args);
} else if (['build', 'up', 'down', 'status', 'logs', 'config'].includes(command)) {
  stack(command, args);
} else if (command === 'release') {
  const subcommand = args.shift();
  if (subcommand === 'build') buildRelease(args);
  else if (subcommand === 'verify') verifyRelease(args);
  else if (subcommand === 'check' && (args.length === 0 || (args.length === 1 && args[0] === '--source'))) {
    releaseCheck({ source: args[0] === '--source' });
  }
  else fail('usage: ./revival release check [--source] | build ... | verify ...');
} else if (command === 'deploy') {
  if (args.shift() !== 'production') fail('usage: ./revival deploy production [--dry-run]');
  deployProduction(args);
} else if (command === 'backup') {
  deploymentScript('backup.sh', args);
} else if (command === 'canary') {
  deploymentScript('canary.sh', args);
} else if (command === 'drift') {
  deploymentScript('drift.sh', args);
} else if (command === 'adopt-config') {
  adoptProtectedConfiguration(args);
} else if (command === 'prune-state') {
  pruneState(args);
} else if (command === 'rollback') {
  rollbackProduction(args);
} else if (command === 'pin') {
  pinCommand(args);
} else if (command === 'test') {
  if (args.length > 1 || (args.length === 1 && args[0] !== '--source')) {
    fail('usage: ./revival test [--source]', 64);
  }
  releaseCheck({ source: args[0] === '--source' });
} else {
  fail(`unknown command: ${command}`);
}
