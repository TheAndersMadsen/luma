#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=5

REPOSITORY="TheAndersMadsen/ai-pin-revival"
NODE_VERSION="22.14.0"
NODE_X64_SHA256="69b09dba5c8dcb05c4e4273a4340db1005abeafe3927efda2bc5b249e80437ec"
NODE_ARM64_SHA256="08bfbf538bad0e8cbb0269f0173cca28d705874a67a22f60b57d99dc99e30050"
DOCKER_KEY_FINGERPRINT="9DC858229FC7DD38854AE2D88D81803C0EBFCD88"
COSIGN_VERSION="3.1.3"
COSIGN_X64_SIZE="141178250"
COSIGN_X64_SHA256="4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71"
COSIGN_ARM64_SIZE="132747403"
COSIGN_ARM64_SHA256="c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a"

BOOTSTRAP_TMP=""
GH_TOKEN=""

die() {
  printf '%s%serror:%s %s\n' "$BOLD" "$RED" "$RESET" "$1" >&2
  exit 1
}

cleanup() {
  GH_TOKEN=""
  unset GH_TOKEN
  [[ -z "$BOOTSTRAP_TMP" ]] || rm -rf -- "$BOOTSTRAP_TMP"
}

as_root() {
  if (( EUID == 0 )); then "$@"; else sudo "$@"; fi
}

node_is_supported() {
  command -v node >/dev/null 2>&1 &&
    node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major === 22 && minor >= 14 ? 0 : 1)' \
      >/dev/null 2>&1
}

compose_is_supported() {
  command -v docker >/dev/null 2>&1 || return 1
  local observed
  observed="$(docker compose version --short 2>/dev/null || true)"
  node - "$observed" <<'NODE' >/dev/null 2>&1
const value = process.argv[2] || "";
const match = value.match(/^v?(\d+)\.(\d+)\.(\d+)(?:[-+].*)?$/u);
process.exit(match && (Number(match[1]) > 2 ||
  (Number(match[1]) === 2 && Number(match[2]) >= 34)) ? 0 : 1);
NODE
}

install_node() {
  local node_arch node_sha archive install_root
  case "$(uname -m)" in
    x86_64) node_arch="x64"; node_sha="$NODE_X64_SHA256" ;;
    aarch64|arm64) node_arch="arm64"; node_sha="$NODE_ARM64_SHA256" ;;
    *) die "Node.js is not pinned for this architecture." ;;
  esac
  archive="$BOOTSTRAP_TMP/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"
  install_root="/usr/local/lib/nodejs/node-v${NODE_VERSION}-linux-${node_arch}"
  curl --fail --location --proto '=https' --tlsv1.2 \
    --output "$archive" "https://nodejs.org/dist/v${NODE_VERSION}/$(basename "$archive")"
  printf '%s  %s\n' "$node_sha" "$archive" | sha256sum --check --status ||
    die "the pinned Node.js download failed its SHA-256 check."
  as_root install -d -m 0755 /usr/local/lib/nodejs
  if [[ -e "$install_root" ]]; then
    [[ -x "$install_root/bin/node" ]] &&
      [[ "$($install_root/bin/node --version)" == "v${NODE_VERSION}" ]] ||
      die "the pinned Node.js destination already contains different files: $install_root"
  else
    as_root tar -xJf "$archive" -C /usr/local/lib/nodejs
  fi
  local command
  for command in node npm npx corepack; do
    if [[ -e "/usr/local/bin/$command" && ! -L "/usr/local/bin/$command" ]]; then
      die "/usr/local/bin/$command already exists and is not a symlink; install Node.js 22.14+ yourself and rerun."
    fi
    as_root ln -sfn "$install_root/bin/$command" "/usr/local/bin/$command"
  done
  hash -r
  node_is_supported || die "the pinned Node.js runtime was installed but is not available on PATH."
}

install_docker() {
  local key="$BOOTSTRAP_TMP/docker.asc" fingerprint architecture
  as_root apt-get update
  as_root apt-get install -y ca-certificates curl gnupg
  curl --fail --location --proto '=https' --tlsv1.2 \
    --output "$key" https://download.docker.com/linux/ubuntu/gpg
  fingerprint="$(gpg --batch --show-keys --with-colons "$key" 2>/dev/null |
    awk -F: '$1 == "fpr" { print $10; exit }')"
  [[ "$fingerprint" == "$DOCKER_KEY_FINGERPRINT" ]] ||
    die "Docker's repository key did not match the pinned fingerprint."
  architecture="$(dpkg --print-architecture)"
  as_root install -d -m 0755 /etc/apt/keyrings
  as_root install -m 0644 "$key" /etc/apt/keyrings/docker.asc
  printf '%s\n' \
    'Types: deb' \
    'URIs: https://download.docker.com/linux/ubuntu' \
    'Suites: noble' \
    'Components: stable' \
    "Architectures: $architecture" \
    'Signed-By: /etc/apt/keyrings/docker.asc' |
    as_root tee /etc/apt/sources.list.d/docker.sources >/dev/null
  as_root apt-get update
  as_root apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  as_root systemctl enable --now docker
  if (( EUID != 0 )); then as_root usermod -aG docker "$(id -un)"; fi
  compose_is_supported || die "Docker Compose 2.34+ was not available after installation."
}

docker_mode() {
  if docker info >/dev/null 2>&1; then
    printf 'direct'
  elif (( EUID != 0 )) && command -v sg >/dev/null 2>&1 &&
      getent group docker | awk -F: -v user="$(id -un)" '
        { count = split($4, members, ","); for (i = 1; i <= count; i++) if (members[i] == user) found = 1 }
        END { exit(found ? 0 : 1) }'; then
    printf 'group'
  else
    die "Docker is installed, but this user cannot reach it. Start a new login session and rerun."
  fi
}

docker_login() {
  local mode="$1" user="$2"
  if [[ "$mode" == "direct" ]]; then
    printf '%s' "$GH_TOKEN" | docker login ghcr.io --username "$user" --password-stdin
  else
    printf '%s' "$GH_TOKEN" | sg docker -c "docker login ghcr.io --username $user --password-stdin"
  fi
}

run_operator() {
  local mode="$1" directory="$2" command
  if [[ "$mode" == "direct" ]]; then
    (cd "$directory" && ./revival onboard production)
  else
    printf -v command 'cd %q && exec ./revival onboard production' "$directory"
    sg docker -c "$command"
  fi
}

download_release_asset() {
  local name="$1" maximum="$2" destination="$3" asset_url asset_size
  IFS="$(printf '\t')" read -r asset_url asset_size <<EOF
$(node --input-type=module - "$RELEASE_METADATA" "$REPOSITORY" "$RELEASE_TAG" "$name" "$maximum" <<'NODE'
import { readFileSync } from "node:fs";
const [file, repository, tag, name, maximumText] = process.argv.slice(2);
const release = JSON.parse(readFileSync(file, "utf8"));
const maximum = Number(maximumText);
const matches = Array.isArray(release.assets)
  ? release.assets.filter((asset) => asset?.name === name)
  : [];
if (release.tag_name !== tag || release.draft !== false || release.prerelease !== false || matches.length !== 1) {
  throw new Error("release metadata does not name one expected stable asset");
}
const asset = matches[0];
const api = `https://api.github.com/repos/${repository}/releases/assets/${asset.id}`;
const browser = `https://github.com/${repository}/releases/download/${tag}/${name}`;
if (!Number.isSafeInteger(asset.id) || asset.id < 1 || !Number.isSafeInteger(asset.size) ||
    asset.size < 1 || asset.size > maximum || asset.url !== api || asset.browser_download_url !== browser) {
  throw new Error("release asset metadata is invalid");
}
console.log(`${api}\t${asset.size}`);
NODE
)
EOF
  curl --fail --location --proto '=https' --proto-redir '=https' --tlsv1.2 \
    --header "Authorization: Bearer $GH_TOKEN" \
    --header 'Accept: application/octet-stream' \
    --header 'X-GitHub-Api-Version: 2022-11-28' \
    --max-filesize "$asset_size" --output "$destination" "$asset_url"
  [[ "$(stat --format='%s' "$destination")" == "$asset_size" ]] ||
    die "$name did not match its published size."
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  printf '%s\n' 'Usage: bash revival-bootstrap' '' \
    'Interactively installs supported host tools, authenticates and verifies the latest stable' \
    'operator release, prepares production, deploys it, verifies it, and prints Guided Setup.'
  exit 0
fi
(( $# == 0 )) || die "usage: bash revival-bootstrap"
[[ -t 0 && -t 1 ]] || die "bootstrap requires an interactive terminal."
if (( EUID == 0 )) && [[ -n "${SUDO_USER:-}" ]]; then
  die "run bootstrap as your normal user; it asks for sudo only when needed."
fi

BOOTSTRAP_TMP="$(mktemp -d)"
ENV_FILE="$BOOTSTRAP_TMP/no-persisted-secrets"
trap cleanup EXIT HUP INT TERM

banner "Ai Pin Revival · stock Pin setup"

stage "Host and prerequisites"
source /etc/os-release
[[ "${ID:-}" == "ubuntu" && "${VERSION_ID:-}" == "24.04" ]] ||
  die "production bootstrap supports Ubuntu 24.04 only."
case "$(uname -m)" in x86_64|aarch64|arm64) ;; *) die "this host architecture is unsupported." ;; esac
if (( EUID != 0 )) && ! command -v sudo >/dev/null 2>&1; then
  die "sudo is required to install missing host tools."
fi
as_root apt-get update
as_root apt-get install -y ca-certificates curl xz-utils
if ! node_is_supported; then
  confirm "Install the pinned Node.js $NODE_VERSION runtime under /usr/local?" || die "Node.js installation declined."
  install_node
else
  say "Node.js 22.14+ is already available."
fi
if ! compose_is_supported; then
  confirm "Install or upgrade Docker Engine and Compose from Docker's official repository?" ||
    die "Docker installation declined."
  install_docker
else
  say "Docker Engine and Compose 2.34+ are already available."
fi
DOCKER_MODE="$(docker_mode)"

stage "Private release access"
say "The repository is private, so setup needs a GitHub token with repository and package read access."
if command -v gh >/dev/null 2>&1 && gh auth status --hostname github.com >/dev/null 2>&1; then
  GH_TOKEN="$(gh auth token --hostname github.com)"
  say "Using the existing authenticated GitHub CLI session."
else
  ask_secret GH_TOKEN "GitHub token (input stays hidden and is not saved):"
fi
[[ -n "$GH_TOKEN" ]] || die "a GitHub token is required while the repository is private."
export GH_TOKEN
USER_METADATA="$BOOTSTRAP_TMP/user.json"
curl --fail --proto '=https' --tlsv1.2 --max-filesize 1048576 \
  --header "Authorization: Bearer $GH_TOKEN" \
  --header 'Accept: application/vnd.github+json' \
  --header 'X-GitHub-Api-Version: 2022-11-28' \
  --output "$USER_METADATA" https://api.github.com/user
GITHUB_USER="$(node - "$USER_METADATA" <<'NODE'
const user = require(process.argv[2]);
if (typeof user.login !== "string" || !/^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$/u.test(user.login)) process.exit(1);
process.stdout.write(user.login);
NODE
)" || die "GitHub did not return a valid authenticated user."

stage "Authenticate the latest stable release"
RELEASE_METADATA="$BOOTSTRAP_TMP/release.json"
curl --fail --proto '=https' --tlsv1.2 --max-filesize 2097152 \
  --header "Authorization: Bearer $GH_TOKEN" \
  --header 'Accept: application/vnd.github+json' \
  --header 'X-GitHub-Api-Version: 2022-11-28' \
  --output "$RELEASE_METADATA" "https://api.github.com/repos/$REPOSITORY/releases/latest"
IFS="$(printf '\t')" read -r RELEASE_TAG RELEASE_VERSION <<EOF
$(node --input-type=module - "$RELEASE_METADATA" <<'NODE'
import { readFileSync } from "node:fs";
const release = JSON.parse(readFileSync(process.argv[2], "utf8"));
if (release.draft !== false || release.prerelease !== false ||
    typeof release.tag_name !== "string" || !/^v\d+\.\d+\.\d+$/u.test(release.tag_name)) {
  throw new Error("latest release metadata is not one stable semantic version");
}
console.log(`${release.tag_name}\t${release.tag_name.slice(1)}`);
NODE
)
EOF
DESCRIPTOR="ai-pin-revival-${RELEASE_VERSION}.release.json"
PROOF="ai-pin-revival-${RELEASE_VERSION}.release.sigstore.json"
download_release_asset "$DESCRIPTOR" 2097152 "$BOOTSTRAP_TMP/$DESCRIPTOR"
download_release_asset "$PROOF" 8388608 "$BOOTSTRAP_TMP/$PROOF"
case "$(uname -m)" in
  x86_64) COSIGN_ASSET="cosign-linux-amd64"; COSIGN_SIZE="$COSIGN_X64_SIZE"; COSIGN_SHA256="$COSIGN_X64_SHA256" ;;
  aarch64|arm64) COSIGN_ASSET="cosign-linux-arm64"; COSIGN_SIZE="$COSIGN_ARM64_SIZE"; COSIGN_SHA256="$COSIGN_ARM64_SHA256" ;;
esac
COSIGN="$BOOTSTRAP_TMP/cosign"
curl --fail --location --proto '=https' --tlsv1.2 --max-filesize "$COSIGN_SIZE" \
  --output "$COSIGN" "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/$COSIGN_ASSET"
[[ "$(stat --format='%s' "$COSIGN")" == "$COSIGN_SIZE" ]] || die "Cosign did not match its pinned size."
printf '%s  %s\n' "$COSIGN_SHA256" "$COSIGN" | sha256sum --check --status ||
  die "Cosign did not match its pinned SHA-256."
chmod 0700 "$COSIGN"
"$COSIGN" verify-blob \
  --bundle "$BOOTSTRAP_TMP/$PROOF" \
  --certificate-identity "https://github.com/$REPOSITORY/.github/workflows/release-cli.yml@refs/tags/$RELEASE_TAG" \
  --certificate-oidc-issuer https://token.actions.githubusercontent.com \
  --certificate-github-workflow-repository "$REPOSITORY" \
  --certificate-github-workflow-name 'immutable release' \
  --certificate-github-workflow-ref "refs/tags/$RELEASE_TAG" \
  --certificate-github-workflow-trigger push \
  "$BOOTSTRAP_TMP/$DESCRIPTOR"
IFS="$(printf '\t')" read -r OPERATOR_ARCHIVE OPERATOR_SIZE OPERATOR_SHA256 <<EOF
$(node --input-type=module - "$BOOTSTRAP_TMP/$DESCRIPTOR" "$REPOSITORY" "$RELEASE_TAG" <<'NODE'
import { readFileSync } from "node:fs";
const [file, repository, tag] = process.argv.slice(2);
const descriptor = JSON.parse(readFileSync(file, "utf8"));
const value = descriptor.operator;
if (descriptor.schemaVersion !== 3 || descriptor.source?.repository !== repository ||
    descriptor.source?.tag !== tag || typeof value?.archive !== "string" ||
    !/^[A-Za-z0-9][A-Za-z0-9._-]*$/u.test(value.archive) ||
    !Number.isSafeInteger(value.size) || value.size < 1 ||
    typeof value.sha256 !== "string" || !/^[0-9a-f]{64}$/u.test(value.sha256)) {
  throw new Error("authenticated descriptor has invalid operator coordinates");
}
console.log(`${value.archive}\t${value.size}\t${value.sha256}`);
NODE
)
EOF
download_release_asset "$OPERATOR_ARCHIVE" "$OPERATOR_SIZE" "$BOOTSTRAP_TMP/$OPERATOR_ARCHIVE"
printf '%s  %s\n' "$OPERATOR_SHA256" "$BOOTSTRAP_TMP/$OPERATOR_ARCHIVE" |
  sha256sum --check --status || die "operator archive did not match the authenticated descriptor."
OPERATORS_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/ai-pin-revival/operators"
install -d -m 0700 "$OPERATORS_ROOT"
INCOMING="$(mktemp -d "$OPERATORS_ROOT/.incoming.XXXXXX")"
tar -xzf "$BOOTSTRAP_TMP/$OPERATOR_ARCHIVE" --no-same-owner -C "$INCOMING"
EXTRACTED="$INCOMING/ai-pin-revival-operator-$RELEASE_VERSION"
[[ -d "$EXTRACTED" && ! -L "$EXTRACTED" ]] || die "operator archive has an unexpected root directory."
OPERATOR_DIR="$OPERATORS_ROOT/$RELEASE_VERSION"
if [[ -e "$OPERATOR_DIR" ]]; then
  [[ -d "$OPERATOR_DIR" && ! -L "$OPERATOR_DIR" ]] || die "operator destination is not a real directory."
  diff -qr "$EXTRACTED" "$OPERATOR_DIR" >/dev/null ||
    die "operator $RELEASE_VERSION already exists with different contents."
  rm -rf -- "$INCOMING"
else
  mv "$EXTRACTED" "$OPERATOR_DIR"
  rmdir "$INCOMING"
fi
say "Authenticated and installed Ai Pin Revival $RELEASE_VERSION."

stage "Container registry access"
say "Logging Docker into GHCR with the same in-memory token. Docker stores it in its protected credential file."
docker_login "$DOCKER_MODE" "$GITHUB_USER"

stage "Configure, deploy, and open Guided Setup"
say "The operator now asks only for the domain, certificate email, owner, public Pin IPv4, and optional features."
run_operator "$DOCKER_MODE" "$OPERATOR_DIR"
note "Operator release: $OPERATOR_DIR"

finish
