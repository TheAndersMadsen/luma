#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate. Returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it. Replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=5

REPOSITORY="TheAndersMadsen/luma"
BUN_VERSION="1.4.2"
BUN_X64_SHA256="c678040f14fe0440eb839d37cbd0ce4c051a32da72806ac97de6a6aab6bf728f"
BUN_ARM64_SHA256="54328bbc2d9c8e0c9f892c544d66c57a83b84139e34909e5ee81758f1ac8fda7"
DOCKER_KEY_FINGERPRINT="9DC858229FC7DD38854AE2D88D81803C0EBFCD88"
COSIGN_VERSION="3.1.3"
COSIGN_X64_SIZE="141178250"
COSIGN_X64_SHA256="4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71"
COSIGN_ARM64_SIZE="132747403"
COSIGN_ARM64_SHA256="c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a"
# The public half of the maintainer's release signing key, the same bytes as
# platform/distribution/release-signing.pub (a platform test keeps them equal;
# `./luma release keygen` writes both). Empty until the maintainer generates
# a key, and an empty key authenticates nothing.
RELEASE_SIGNING_PUBLIC_KEY="$(cat <<'RELEASE_SIGNING_PUBLIC_KEY_PEM'
-----BEGIN PUBLIC KEY-----
MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEj7rYMI4KrQ/wIImcJN4TfvwKK+k8
hXv9F+PnBx8t8nRSPiDS3WtpGvQo2RYzBaxjEoyT7D3rTIBXUyJjezK/XA==
-----END PUBLIC KEY-----
RELEASE_SIGNING_PUBLIC_KEY_PEM
)"
RELEASE_CHECKSUMS="SHA256SUMS"
# Where the installed server asks for newer releases (its Center's
# /api/version). This copy names platform/distribution/update-source.json's
# origin. A Center serving /install.sh puts its own origin on this line.
LUMA_UPDATE_SOURCE_DEFAULT="https://center.andersmadsen.dk"
RELEASE_SIGNATURE="SHA256SUMS.sigstore.json"
MINIMUM_AVAILABLE_KIB="8388608"
SAFE_RETRY="Run the same install command again (bash <(curl -fsSL https://YOUR-CENTER/install.sh)); finished steps are kept and checked, not redone."
UNATTENDED_SAFE_RETRY="Sign in as root and run the interactive install (bash <(curl -fsSL https://YOUR-CENTER/install.sh)), or run it unattended again with LUMA_UNATTENDED=1, the same LUMA_* settings, and freshly written token files; finished steps are kept and checked, not redone."
# Every value the cloud-init template ships unfilled carries this marker, so
# an unattended install refuses to start on one instead of registering a
# placeholder domain or sending a placeholder token anywhere.
PLACEHOLDER_MARK="REPLACE_ME"

BOOTSTRAP_TMP=""
GH_TOKEN=""
DUCKDNS_TOKEN=""
UNATTENDED=false
CURRENT_STAGE="Startup"
CHANGE_STATE="Nothing was changed."

report_failure() {
  local message="$1"
  trap - ERR
  printf '\n%s%s  Setup stopped · %s%s\n' "$BOLD" "$RED" "$CURRENT_STAGE" "$RESET" >&2
  printf '  What failed: %s\n' "$message" >&2
  printf '  State: %s\n' "$CHANGE_STATE" >&2
  printf '  Device state: No Pin was contacted or changed.\n' >&2
  printf '  Safe retry: %s\n\n' "$SAFE_RETRY" >&2
}

die() {
  report_failure "$1"
  exit 1
}

unexpected_failure() {
  local status="$?"
  report_failure "A required command stopped with exit status $status. Its diagnostic is immediately above."
  exit "$status"
}

cleanup() {
  GH_TOKEN=""
  DUCKDNS_TOKEN=""
  unset GH_TOKEN DUCKDNS_TOKEN
  [[ -z "$BOOTSTRAP_TMP" ]] || rm -rf -- "$BOOTSTRAP_TMP"
}

as_root() {
  if (( EUID == 0 )); then "$@"; else sudo "$@"; fi
}

# approve "question" is the y/N gate of the interactive install. An
# unattended install answered every question by starting, so it records the
# step instead of asking.
approve() {
  if $UNATTENDED; then
    say "$1 Yes (unattended)."
    return 0
  fi
  confirm "$1"
}

# unattended_value NAME [DEFAULT] prints the environment value NAME, or
# DEFAULT when it is unset or empty, and stops on a template placeholder.
# Only settings come this way. A secret is never an environment value.
unattended_value() {
  local name="$1" value="${!1:-}"
  [[ -n "$value" ]] || value="${2:-}"
  [[ "$value" != *"$PLACEHOLDER_MARK"* ]] ||
    die "$name still holds the template placeholder. Fill every REPLACE_ME value in the cloud-init file, then create the server again."
  printf '%s' "$value"
}

# read_secret_file VARIABLE PATH reads one secret into VARIABLE from a file
# only this user can read (a regular file, mode 0600, owned by this user),
# then shreds the file: the secret lives on in this process only. The file
# holds the value on its first line. A trailing newline is not part of it.
read_secret_file() {
  local variable="$1" file="$2" name="$3" mode owner value
  [[ -n "$file" ]] || die "$name is required: set its LUMA_*_FILE variable to a mode-0600 file holding the value."
  [[ -f "$file" && ! -L "$file" ]] || die "$name file $file is not a regular file."
  mode="$(stat --format='%a' "$file")"
  owner="$(stat --format='%u' "$file")"
  [[ "$mode" == "600" ]] || die "$name file $file must have mode 0600, not $mode."
  [[ "$owner" == "$EUID" ]] || die "$name file $file must be owned by the user running the install."
  IFS= read -r value < "$file" || true
  shred_file "$file"
  [[ -n "$value" ]] || die "$name file $file is empty."
  [[ "$value" != *"$PLACEHOLDER_MARK"* ]] ||
    die "$name file $file still holds the template placeholder. Fill every REPLACE_ME value in the cloud-init file, then create the server again."
  printf -v "$variable" '%s' "$value"
}

# shred_file PATH overwrites and removes a secret file. Ubuntu's coreutils
# ships shred. Without it the secret would stay on disk, so the install stops.
shred_file() {
  command -v shred >/dev/null 2>&1 || die "shred (coreutils) is missing, so the secret file $1 cannot be removed safely."
  shred --iterations=1 --zero --remove=unlink -- "$1" || die "the secret file $1 could not be shredded."
}

# unattended_inputs collects every setting and secret of an unattended
# install before anything changes, so a missing or placeholder value stops
# the install with nothing to undo. Secrets come from files only.
unattended_inputs() {
  local domain duckdns profiles public_ip github_token_file duckdns_token_file auto_updates
  domain="$(unattended_value LUMA_DOMAIN)"
  duckdns="$(unattended_value LUMA_DUCKDNS_SUBDOMAIN)"
  UNATTENDED_ACME_EMAIL="$(unattended_value LUMA_ACME_EMAIL)"
  UNATTENDED_OPERATOR_EMAIL="$(unattended_value LUMA_OPERATOR_EMAIL)"
  profiles="$(unattended_value LUMA_PROFILES pin,search,spotify)"
  public_ip="$(unattended_value LUMA_PUBLIC_IP auto)"
  UNATTENDED_UPDATE_SOURCE="$(unattended_value LUMA_UPDATE_SOURCE "$LUMA_UPDATE_SOURCE_DEFAULT")"
  auto_updates="$(unattended_value LUMA_AUTO_UPDATES on)"
  [[ "$auto_updates" == on || "$auto_updates" == off ]] || die "LUMA_AUTO_UPDATES must be on or off."
  UNATTENDED_AUTO_UPDATES="$auto_updates"
  github_token_file="$(unattended_value LUMA_GITHUB_TOKEN_FILE)"
  duckdns_token_file="$(unattended_value LUMA_DUCKDNS_TOKEN_FILE)"
  if [[ -n "$domain" && -n "$duckdns" ]]; then
    die "Set either LUMA_DOMAIN or LUMA_DUCKDNS_SUBDOMAIN, not both."
  fi
  [[ -n "$domain" || -n "$duckdns" ]] || die "LUMA_DOMAIN (a DNS name that points at this server) or LUMA_DUCKDNS_SUBDOMAIN (a free DuckDNS name) is required."
  [[ -n "$UNATTENDED_ACME_EMAIL" ]] || die "LUMA_ACME_EMAIL (the TLS certificate email) is required."
  [[ -n "$UNATTENDED_OPERATOR_EMAIL" ]] || die "LUMA_OPERATOR_EMAIL (the first Center owner) is required."
  UNATTENDED_DUCKDNS_SUBDOMAIN="${duckdns%.duckdns.org}"
  UNATTENDED_DOMAIN="${domain:-$UNATTENDED_DUCKDNS_SUBDOMAIN.duckdns.org}"
  UNATTENDED_PROFILES=()
  if [[ ! "$profiles" =~ ^(none|no)$ ]]; then
    IFS=', ' read -r -a UNATTENDED_PROFILES <<<"$profiles"
  fi
  UNATTENDED_PUBLIC_IP="$public_ip"
  # The GitHub token is optional: a public release and its public images need
  # none. A private fork supplies one through LUMA_GITHUB_TOKEN_FILE.
  if [[ -n "$github_token_file" ]]; then
    read_secret_file GH_TOKEN "$github_token_file" "The GitHub token"
  fi
  if [[ -n "$UNATTENDED_DUCKDNS_SUBDOMAIN" ]]; then
    read_secret_file DUCKDNS_TOKEN "$duckdns_token_file" "The DuckDNS token"
  elif [[ -n "$duckdns_token_file" && -f "$duckdns_token_file" ]]; then
    # The template ships the file either way. An install with its own domain
    # never reads it.
    shred_file "$duckdns_token_file"
  fi
}

# run_luma ARGS... runs ./luma ARGS in the operator release, through the
# Docker group when this user is not root, with this process's stdin.
run_luma() {
  local command argument
  if [[ "$DOCKER_MODE" == "direct" ]]; then
    (cd "$OPERATOR_DIR" && ./luma "$@")
  else
    printf -v command 'cd %q && exec ./luma' "$OPERATOR_DIR"
    for argument in "$@"; do printf -v command '%s %q' "$command" "$argument"; done
    sg docker -c "$command"
  fi
}

# run_operator_unattended is `./luma onboard production` without its two
# questions: setup with explicit flags (the DuckDNS token on stdin, never in
# an argument), doctor, the dry run, the confirmed deploy, and verification.
# Each step names its own stage, so a failure reports where it stopped.
run_operator_unattended() {
  local setup=(setup production --acme-email "$UNATTENDED_ACME_EMAIL" --operator-email "$UNATTENDED_OPERATOR_EMAIL")
  local profile has_pin=false
  if [[ -n "$UNATTENDED_DUCKDNS_SUBDOMAIN" ]]; then
    setup+=(--duckdns-subdomain "$UNATTENDED_DUCKDNS_SUBDOMAIN" --duckdns-token-stdin)
  else
    setup+=(--domain "$UNATTENDED_DOMAIN")
  fi
  if (( ${#UNATTENDED_PROFILES[@]} == 0 )); then
    setup+=(--no-profiles)
  else
    for profile in "${UNATTENDED_PROFILES[@]}"; do
      setup+=(--profile "$profile")
      if [[ "$profile" == pin ]]; then has_pin=true; fi
    done
  fi
  # Only the pin profile needs the public IPv4 (setup stores it for the Pin
  # edge); `auto` asks setup to detect it.
  if $has_pin; then setup+=(--public-ip "$UNATTENDED_PUBLIC_IP"); fi
  setup+=(--update-source "$UNATTENDED_UPDATE_SOURCE" --auto-updates "$UNATTENDED_AUTO_UPDATES")

  CURRENT_STAGE="Configure production (setup)"
  CHANGE_STATE="Host tools, operator access, and any configuration file setup wrote were preserved. Production was not deployed."
  if [[ -n "$UNATTENDED_DUCKDNS_SUBDOMAIN" ]]; then
    printf '%s\n' "$DUCKDNS_TOKEN" | run_luma "${setup[@]}"
  else
    run_luma "${setup[@]}" </dev/null
  fi
  DUCKDNS_TOKEN=""
  CURRENT_STAGE="Check host, release, and configuration (doctor)"
  CHANGE_STATE="Host tools, operator access, and the production configuration were preserved. Production was not deployed."
  run_luma doctor production </dev/null
  CURRENT_STAGE="Prove the deployment plan (deploy --dry-run)"
  run_luma deploy production --dry-run </dev/null
  CURRENT_STAGE="Deploy the verified release (deploy --confirm)"
  CHANGE_STATE="The deployment started, so server containers may have changed. Configuration was preserved."
  run_luma deploy production --confirm </dev/null
  CURRENT_STAGE="Verify production (verify)"
  CHANGE_STATE="The deployed server state was preserved so it can be inspected and retried safely."
  run_luma verify production </dev/null
  say "Center: https://$UNATTENDED_DOMAIN/login?next=%2Fsettings%2Fpin%2Fsetup"
  say "First sign-in: show it once with cat ${XDG_CONFIG_HOME:-$HOME/.config}/luma/production/first-login.txt, sign in, then delete the file."
}

validate_supported_host() {
  local release_file="$1" architecture="$2"
  [[ -r "$release_file" ]] ||
    die "Ubuntu release information is missing. Use a fresh 64-bit Ubuntu 24.04 server with /etc/os-release."
  unset ID VERSION_ID
  # /etc/os-release is the operating system's canonical release declaration.
  source "$release_file"
  [[ "${ID:-}" == "ubuntu" && "${VERSION_ID:-}" == "24.04" ]] ||
    die "Production setup requires 64-bit Ubuntu 24.04. This server reports ${ID:-unknown} ${VERSION_ID:-unknown}."
  case "$architecture" in
    x86_64|aarch64|arm64) ;;
    *) die "Production setup supports only amd64/x86_64 and arm64/aarch64; this server reports $architecture." ;;
  esac
}

check_available_capacity() {
  local directory="$1" available
  available="$(df -Pk "$directory" 2>/dev/null | awk 'NR == 2 { print $4 }')"
  [[ "$available" =~ ^[0-9]+$ ]] || die "Available disk space could not be measured for the operator data location."
  (( available >= MINIMUM_AVAILABLE_KIB )) ||
    die "At least 8 GiB of free disk space is required before downloading production images. Free space, resize the VPS disk, then rerun."
}

incompatible_docker_packages() {
  local package status found=()
  command -v dpkg-query >/dev/null 2>&1 || return 0
  for package in docker.io docker-compose docker-compose-v2 podman-docker containerd runc; do
    status="$(dpkg-query -W -f='${db:Status-Abbrev}' "$package" 2>/dev/null || true)"
    [[ "$status" == "ii " ]] && found+=("$package")
  done
  ((${#found[@]})) && printf '%s' "${found[*]}"
}

# github_auth_header prints the token's header for `curl --header @-`, so the
# token never enters an argument list that `ps` shows other users. printf is a
# shell builtin, so it starts no process either.
github_auth_header() {
  # No token is needed for a public repository and its public images. With one
  # (a private fork), it authenticates every GitHub API call and download.
  [[ -n "$GH_TOKEN" ]] || return 0
  printf 'Authorization: Bearer %s\n' "$GH_TOKEN"
}

github_api() {
  local url="$1" destination="$2" access="$3" status
  if ! status="$(github_auth_header | curl --silent --show-error --proto '=https' --tlsv1.2 --max-filesize 2097152 \
      --header @- \
      --header 'Accept: application/vnd.github+json' \
      --header 'X-GitHub-Api-Version: 2022-11-28' \
      --output "$destination" --write-out '%{http_code}' "$url")"; then
    die "GitHub could not be reached securely. Check DNS and outbound HTTPS access, then rerun."
  fi
  [[ "$status" == "200" ]] ||
    die "GitHub could not confirm $access (HTTP $status). Check your network, and for a private fork that the token is valid and authorized, then rerun."
}

bun_is_supported() {
  command -v bun >/dev/null 2>&1 && [[ "$(bun --version)" == "$BUN_VERSION" ]]
}

compose_is_supported() {
  command -v docker >/dev/null 2>&1 || return 1
  local observed
  observed="$(docker compose version --short 2>/dev/null || true)"
  bun --no-env-file - "$observed" <<'BUN' >/dev/null 2>&1
const value = process.argv[2] || "";
const match = value.match(/^v?(\d+)\.(\d+)\.(\d+)(?:[-+].*)?$/u);
process.exit(match && (Number(match[1]) > 2 ||
  (Number(match[1]) === 2 && Number(match[2]) >= 34)) ? 0 : 1);
BUN
}

install_bun() {
  local bun_arch bun_sha archive install_root
  case "$(uname -m)" in
    x86_64) bun_arch="x64-baseline"; bun_sha="$BUN_X64_SHA256" ;;
    aarch64|arm64) bun_arch="aarch64"; bun_sha="$BUN_ARM64_SHA256" ;;
    *) die "Bun is not pinned for this architecture." ;;
  esac
  archive="$BOOTSTRAP_TMP/bun-linux-${bun_arch}.zip"
  install_root="/usr/local/lib/bun-${BUN_VERSION}"
  curl --fail --location --proto '=https' --tlsv1.2 \
    --output "$archive" "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/$(basename "$archive")"
  printf '%s  %s\n' "$bun_sha" "$archive" | sha256sum --check --status ||
    die "the pinned Bun download failed its SHA-256 check."
  unzip -q "$archive" -d "$BOOTSTRAP_TMP/bun"
  as_root install -d -m 0755 "$install_root"
  as_root install -m 0755 "$BOOTSTRAP_TMP/bun/bun-linux-${bun_arch}/bun" "$install_root/bun"
  if [[ -e /usr/local/bin/bun && ! -L /usr/local/bin/bun ]]; then
    die "/usr/local/bin/bun is not a symlink; install Bun $BUN_VERSION yourself and rerun."
  fi
  as_root ln -sfn "$install_root/bun" /usr/local/bin/bun
  hash -r
  bun_is_supported || die "Bun was installed but is not available on PATH."
}

install_docker() {
  local key="$BOOTSTRAP_TMP/docker.asc" fingerprint architecture
  as_root apt-get update
  as_root apt-get install -y ca-certificates curl gnupg
  curl --fail --location --proto '=https' --tlsv1.2 \
    --output "$key" https://download.docker.com/linux/ubuntu/gpg
  fingerprint="$(gpg --batch --show-keys --with-colons "$key" 2>/dev/null |
    awk -F: '$1 == "fpr" { print $10; exit }')"
  [[ "$fingerprint" == "$DOCKER_KEY_FINGERPRINT" ]] ||
    die "Docker's repository key did not match the pinned fingerprint."
  architecture="$(dpkg --print-architecture)"
  as_root install -d -m 0755 /etc/apt/keyrings
  as_root install -m 0644 "$key" /etc/apt/keyrings/docker.asc
  printf '%s\n' \
    'Types: deb' \
    'URIs: https://download.docker.com/linux/ubuntu' \
    'Suites: noble' \
    'Components: stable' \
    "Architectures: $architecture" \
    'Signed-By: /etc/apt/keyrings/docker.asc' |
    as_root tee /etc/apt/sources.list.d/docker.sources >/dev/null
  as_root apt-get update
  as_root apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  as_root systemctl enable --now docker
  if (( EUID != 0 )); then as_root usermod -aG docker "$(id -un)"; fi
  compose_is_supported || die "Docker Compose 2.34+ was not available after installation."
}

docker_mode() {
  if docker info >/dev/null 2>&1; then
    printf 'direct'
  elif (( EUID != 0 )) && command -v sg >/dev/null 2>&1 &&
      getent group docker | awk -F: -v user="$(id -un)" '
        { count = split($4, members, ","); for (i = 1; i <= count; i++) if (members[i] == user) found = 1 }
        END { exit(found ? 0 : 1) }'; then
    printf 'group'
  else
    die "Docker is installed, but this user cannot reach it. Start a new login session and rerun."
  fi
}

# create_data_dirs DATA_ROOT creates Luma's data root, its operator releases,
# and its build directory. The operator refuses a data root other users can
# read, and `install -m` sets the mode only of the directories it names, so
# every level is named.
create_data_dirs() {
  install -d -m 0700 "$1" "$1/operators" "$1/build"
}

# docker_login MODE USER DOCKER_CONFIG stores the GHCR login in the Docker
# configuration that onboarding and every ./luma deploy use (LUMA_BUILD_DIR).
docker_login() {
  local mode="$1" user="$2" config="$3" command
  if [[ "$mode" == "direct" ]]; then
    printf '%s' "$GH_TOKEN" | DOCKER_CONFIG="$config" docker login ghcr.io --username "$user" --password-stdin ||
      die "GHCR login failed. The GitHub token needs package read access (read:packages), plus access to the repository's packages if it is a private fork."
  else
    printf -v command 'DOCKER_CONFIG=%q docker login ghcr.io --username %q --password-stdin' "$config" "$user"
    printf '%s' "$GH_TOKEN" | sg docker -c "$command" ||
      die "GHCR login failed. The GitHub token needs package read access (read:packages), plus access to the repository's packages if it is a private fork."
  fi
}

run_operator() {
  local mode="$1" directory="$2" command
  if [[ "$mode" == "direct" ]]; then
    (cd "$directory" && ./luma onboard production --update-source "$LUMA_UPDATE_SOURCE_DEFAULT")
  else
    printf -v command 'cd %q && exec ./luma onboard production --update-source %q' "$directory" "$LUMA_UPDATE_SOURCE_DEFAULT"
    sg docker -c "$command"
  fi
}

# save_github_token SECRETS_DIR keeps the token this install already holds for
# ./luma update production, which downloads later private releases with it:
# one mode-0600 file in Luma's secrets directory. printf is a shell builtin,
# so the token enters no argument list.
save_github_token() {
  local secrets="$1" partial
  install -d -m 0700 "$(dirname "$secrets")" "$secrets"
  partial="$secrets/.github-token.partial"
  ( umask 077; printf '%s\n' "$GH_TOKEN" > "$partial" )
  chmod 0600 "$partial"
  mv -f "$partial" "$secrets/github-token"
}

# download_release_asset NAME MAXIMUM DESTINATION downloads one asset of the
# authenticated release. Each Node helper here is captured first and checked,
# so malformed metadata ends in one plain sentence instead of a stack trace and
# a curl call with empty arguments.
download_release_asset() {
  local name="$1" maximum="$2" destination="$3" fields asset_url asset_size
  fields="$(bun --no-env-file --input-type=module - "$RELEASE_METADATA" "$REPOSITORY" "$RELEASE_TAG" "$name" "$maximum" \
      2>/dev/null <<'BUN'
import { readFileSync } from "node:fs";
const [file, repository, tag, name, maximumText] = process.argv.slice(2);
const release = JSON.parse(readFileSync(file, "utf8"));
const maximum = Number(maximumText);
const matches = Array.isArray(release.assets)
  ? release.assets.filter((asset) => asset?.name === name)
  : [];
if (release.tag_name !== tag || release.draft !== false || release.prerelease !== false || matches.length !== 1) {
  throw new Error("release metadata does not name one expected stable asset");
}
const asset = matches[0];
const api = `https://api.github.com/repos/${repository}/releases/assets/${asset.id}`;
const browser = `https://github.com/${repository}/releases/download/${tag}/${name}`;
if (!Number.isSafeInteger(asset.id) || asset.id < 1 || !Number.isSafeInteger(asset.size) ||
    asset.size < 1 || asset.size > maximum || asset.url !== api || asset.browser_download_url !== browser) {
  throw new Error("release asset metadata is invalid");
}
console.log(`${api}\t${asset.size}`);
BUN
)" || die "GitHub's metadata for Luma $RELEASE_VERSION does not list $name as one valid release file. Nothing was downloaded."
  IFS="$(printf '\t')" read -r asset_url asset_size <<<"$fields"
  [[ "$asset_url" == https://api.github.com/* && "$asset_size" =~ ^[1-9][0-9]*$ ]] ||
    die "GitHub's metadata for Luma $RELEASE_VERSION gave no usable download for $name. Nothing was downloaded."
  if ! github_auth_header | curl --fail --location --silent --show-error --proto '=https' --proto-redir '=https' --tlsv1.2 \
      --header @- \
      --header 'Accept: application/octet-stream' \
      --header 'X-GitHub-Api-Version: 2022-11-28' \
      --max-filesize "$asset_size" --output "$destination" "$asset_url"; then
    die "GitHub could not download $name. Confirm repository read access and retry; partial bytes will be discarded."
  fi
  [[ "$(stat --format='%s' "$destination")" == "$asset_size" ]] ||
    die "$name did not match its published size."
}

# release_identity METADATA prints "TAG<TAB>VERSION<TAB>signed|unsigned" for
# GitHub's latest release, or fails without output when it is not one stable
# semantic version. "unsigned" means the release carries no SHA256SUMS with
# the maintainer's signature over it.
release_identity() {
  bun --no-env-file --input-type=module - "$1" "$RELEASE_CHECKSUMS" "$RELEASE_SIGNATURE" 2>/dev/null <<'BUN'
import { readFileSync } from "node:fs";
const [file, ...required] = process.argv.slice(2);
const release = JSON.parse(readFileSync(file, "utf8"));
if (release.draft !== false || release.prerelease !== false ||
    typeof release.tag_name !== "string" || !/^v\d+\.\d+\.\d+$/u.test(release.tag_name)) {
  process.exit(1);
}
const version = release.tag_name.slice(1);
const names = new Set(Array.isArray(release.assets) ? release.assets.map((asset) => asset?.name) : []);
const signed = required.every((name) => names.has(name));
console.log(`${release.tag_name}\t${version}\t${signed ? "signed" : "unsigned"}`);
BUN
}

# unsigned_release_message VERSION says why this installer stops for a release
# published without the maintainer's signature, and where to go instead.
unsigned_release_message() {
  printf '%s' "Luma $1 was published without the maintainer's signature over its checksums ($RELEASE_SIGNATURE), so this installer cannot authenticate it and installed nothing from it." \
    " Install it from its release files instead: docs/install.md \"Install the release\" (https://github.com/$REPOSITORY/blob/main/docs/install.md#2-install-the-release)." \
    " Bun and Docker, step 1 of that path, stay installed."
}

# verify_release_checksums COSIGN CHECKSUMS SIGNATURE stops unless SIGNATURE is
# the maintainer's cosign signature over exactly these CHECKSUMS bytes under
# the embedded public key. Signing never used a transparency log, so
# verification ignores it.
verify_release_checksums() {
  local cosign="$1" checksums="$2" signature="$3" public_key
  [[ -n "$RELEASE_SIGNING_PUBLIC_KEY" ]] ||
    die "This installer carries no release signing key yet, so it can authenticate no release. The maintainer creates one with ./luma release keygen and publishes a release signed with it."
  public_key="$BOOTSTRAP_TMP/release-signing.pub"
  printf '%s\n' "$RELEASE_SIGNING_PUBLIC_KEY" > "$public_key"
  "$cosign" verify-blob --key "$public_key" --bundle "$signature" --insecure-ignore-tlog "$checksums" >/dev/null 2>&1 ||
    die "$RELEASE_CHECKSUMS of Luma $RELEASE_VERSION is not signed by Luma's release signing key, so nothing from it was installed."
}

# checksum_listed CHECKSUMS NAME DIRECTORY fails unless CHECKSUMS lists NAME
# exactly once and DIRECTORY/NAME has that SHA-256.
checksum_listed() {
  local checksums="$1" name="$2" directory="$3" rows
  rows="$(awk -v name="$name" '$2 == name' "$checksums")"
  [[ "$(printf '%s\n' "$rows" | grep -c .)" == 1 ]] || return 1
  (cd "$directory" && printf '%s\n' "$rows" | sha256sum --check --status)
}

main() {
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  printf '%s\n' 'Usage: bash bootstrap [--tools-only]' '' \
    'Interactively installs supported host tools, authenticates and verifies the latest stable' \
    'operator release, prepares production, deploys it, verifies it, and prints Guided Setup.' \
    '' '--tools-only prepares Bun and Docker, then stops before release access and setup.' \
    '' 'LUMA_UNATTENDED=1 runs the whole install without a terminal (cloud-init user data): settings' \
    'come from LUMA_DOMAIN or LUMA_DUCKDNS_SUBDOMAIN, LUMA_ACME_EMAIL, LUMA_OPERATOR_EMAIL, LUMA_PROFILES' \
    '(default pin,search,spotify), and LUMA_PUBLIC_IP (default auto); the secrets only from the mode-0600' \
    'files LUMA_GITHUB_TOKEN_FILE and LUMA_DUCKDNS_TOKEN_FILE, which it reads once and shreds.' \
    'LUMA_UPDATE_SOURCE (default: the Center this installer came from) and LUMA_AUTO_UPDATES (on or off,' \
    'default on) choose where the server looks for updates and whether it installs them at night.'
  exit 0
fi
local tools_only=false
if [[ "${1:-}" == --tools-only ]]; then
  tools_only=true
  SAFE_RETRY="Run bash ./bootstrap --tools-only again; installed tools are checked and kept."
  shift
fi
(( $# == 0 )) || die "usage: bash bootstrap [--tools-only]"
if [[ "${LUMA_UNATTENDED:-}" == "1" ]]; then
  UNATTENDED=true
  SAFE_RETRY="$UNATTENDED_SAFE_RETRY"
  ! $tools_only || die "LUMA_UNATTENDED=1 installs everything; it does not combine with --tools-only."
else
  [[ -t 0 && -t 1 ]] || die "bootstrap requires an interactive terminal (LUMA_UNATTENDED=1 runs it without one)."
  if (( EUID == 0 )) && [[ -n "${SUDO_USER:-}" ]]; then
    die "run bootstrap as your normal user; it asks for sudo only when needed."
  fi
fi

BOOTSTRAP_TMP="$(mktemp -d)"
ENV_FILE="$BOOTSTRAP_TMP/no-persisted-secrets"
trap cleanup EXIT HUP INT TERM
trap unexpected_failure ERR
# Functions inherit the ERR trap only with errtrace, so a command that stops
# inside one (Docker's installer, an operator step) still prints the stop
# block with its Safe retry line.
set -E

if $UNATTENDED; then
  printf '\n%s%s  Luma · unattended install of the latest signed release on this server%s\n\n' "$BOLD" "$BLUE" "$RESET"
  CURRENT_STAGE="Unattended settings"
  unattended_inputs
elif $tools_only; then
  TOTAL_STAGES=1
  banner "Luma · prepare this server"
else
  banner "Luma · install the latest signed release on this server"
fi

CURRENT_STAGE="Host and prerequisites"
stage "Host and prerequisites"
validate_supported_host /etc/os-release "$(uname -m)"
command -v apt-get >/dev/null 2>&1 ||
  die "Ubuntu's apt-get command is missing. Restore the base Ubuntu package manager or start with a fresh Ubuntu 24.04 VPS."
if (( EUID != 0 )) && ! command -v sudo >/dev/null 2>&1; then
  die "This account needs sudo access to install host tools. Sign in as the normal sudo-capable VPS user and rerun."
fi
if (( EUID != 0 )) && $UNATTENDED && ! sudo -n -v 2>/dev/null; then
  die "An unattended install needs root or an account with passwordless sudo; nobody can type a sudo password for it."
fi
if (( EUID != 0 )) && ! sudo -v; then
  die "Sudo access was not granted. Ask the VPS owner to grant this account sudo access, then rerun."
fi
check_available_capacity "$HOME"
CHANGE_STATE="Ubuntu host packages may have changed. Operator configuration and production were not changed."
as_root apt-get update
as_root apt-get install -y ca-certificates curl unzip gnupg
if ! bun_is_supported; then
  approve "Install the pinned Bun $BUN_VERSION runtime under /usr/local?" || die "Bun installation declined."
  install_bun
else
  say "Bun $BUN_VERSION is already available."
fi
if ! compose_is_supported; then
  conflicts="$(incompatible_docker_packages || true)"
  [[ -z "$conflicts" ]] ||
    die "An incompatible Docker package is installed: $conflicts. Luma did not remove it because that could stop other containers. Use a fresh VPS, or remove the conflicting package after reviewing its workloads, then rerun."
  approve "Install or upgrade Docker Engine and Compose from Docker's official repository?" ||
    die "Docker installation declined."
  install_docker
else
  say "Docker Engine and Compose 2.34+ are already available."
fi
DOCKER_MODE="$(docker_mode)"
if $tools_only; then
  say "Bun and Docker are ready."
  if [[ "$DOCKER_MODE" == group ]]; then
    say "Reconnect over SSH so this session picks up Docker group membership."
  fi
  say "Continue with ./luma onboard production. (A private fork first runs ./luma registry login.)"
  return 0
fi

CURRENT_STAGE="Release access"
stage "Release access"
say "Luma installs from its public, signed release and public images, so no GitHub token is needed. A private fork can supply a classic token (repo and read:packages) through LUMA_GITHUB_TOKEN_FILE or the GitHub CLI."
if $UNATTENDED; then
  if [[ -n "$GH_TOKEN" ]]; then
    say "Using the GitHub token read from LUMA_GITHUB_TOKEN_FILE (the file is already shredded; Docker keeps the token for image pulls, and Luma keeps it for updates)."
  else
    say "No token was supplied; installing the public release anonymously."
  fi
elif [[ -z "$GH_TOKEN" ]] && command -v gh >/dev/null 2>&1 && gh auth status --hostname github.com >/dev/null 2>&1; then
  GH_TOKEN="$(gh auth token --hostname github.com)"
  say "Using the existing authenticated GitHub CLI session."
fi
export GH_TOKEN
if [[ -n "$GH_TOKEN" ]]; then
  USER_METADATA="$BOOTSTRAP_TMP/user.json"
  github_api https://api.github.com/user "$USER_METADATA" "authenticated user access"
  GITHUB_USER="$(bun --no-env-file - "$USER_METADATA" <<'BUN'
const user = require(process.argv[2]);
if (typeof user.login !== "string" || !/^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$/u.test(user.login)) process.exit(1);
process.stdout.write(user.login);
BUN
)" || die "GitHub did not return a valid authenticated user."
fi

CURRENT_STAGE="Authenticate the latest stable release"
stage "Authenticate the latest stable release"
RELEASE_METADATA="$BOOTSTRAP_TMP/release.json"
github_api "https://api.github.com/repos/$REPOSITORY/releases/latest" "$RELEASE_METADATA" \
  "repository read access"
RELEASE_FIELDS="$(release_identity "$RELEASE_METADATA")" ||
  die "GitHub's latest Luma release is not one stable version such as v1.2.3. Nothing was downloaded."
IFS="$(printf '\t')" read -r RELEASE_TAG RELEASE_VERSION RELEASE_PROOF <<<"$RELEASE_FIELDS"
DESCRIPTOR="luma-${RELEASE_VERSION}.release.json"
[[ "$RELEASE_PROOF" == "signed" ]] || die "$(unsigned_release_message "$RELEASE_VERSION")"
download_release_asset "$RELEASE_CHECKSUMS" 65536 "$BOOTSTRAP_TMP/$RELEASE_CHECKSUMS"
download_release_asset "$RELEASE_SIGNATURE" 65536 "$BOOTSTRAP_TMP/$RELEASE_SIGNATURE"
case "$(uname -m)" in
  x86_64) COSIGN_ASSET="cosign-linux-amd64"; COSIGN_SIZE="$COSIGN_X64_SIZE"; COSIGN_SHA256="$COSIGN_X64_SHA256" ;;
  aarch64|arm64) COSIGN_ASSET="cosign-linux-arm64"; COSIGN_SIZE="$COSIGN_ARM64_SIZE"; COSIGN_SHA256="$COSIGN_ARM64_SHA256" ;;
esac
COSIGN="$BOOTSTRAP_TMP/cosign"
curl --fail --location --proto '=https' --tlsv1.2 --max-filesize "$COSIGN_SIZE" \
  --output "$COSIGN" "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/$COSIGN_ASSET"
[[ "$(stat --format='%s' "$COSIGN")" == "$COSIGN_SIZE" ]] || die "Cosign did not match its pinned size."
printf '%s  %s\n' "$COSIGN_SHA256" "$COSIGN" | sha256sum --check --status ||
  die "Cosign did not match its pinned SHA-256."
chmod 0700 "$COSIGN"
verify_release_checksums "$COSIGN" "$BOOTSTRAP_TMP/$RELEASE_CHECKSUMS" "$BOOTSTRAP_TMP/$RELEASE_SIGNATURE"
download_release_asset "$DESCRIPTOR" 2097152 "$BOOTSTRAP_TMP/$DESCRIPTOR"
checksum_listed "$BOOTSTRAP_TMP/$RELEASE_CHECKSUMS" "$DESCRIPTOR" "$BOOTSTRAP_TMP" ||
  die "The release descriptor of Luma $RELEASE_VERSION did not match its signed $RELEASE_CHECKSUMS."
OPERATOR_FIELDS="$(bun --no-env-file --input-type=module - "$BOOTSTRAP_TMP/$DESCRIPTOR" "$REPOSITORY" "$RELEASE_TAG" \
    2>/dev/null <<'BUN'
import { readFileSync } from "node:fs";
const [file, repository, tag] = process.argv.slice(2);
const descriptor = JSON.parse(readFileSync(file, "utf8"));
const value = descriptor.operator;
if (descriptor.schemaVersion !== 3 || descriptor.source?.repository !== repository ||
    descriptor.source?.tag !== tag || typeof value?.archive !== "string" ||
    !/^[A-Za-z0-9][A-Za-z0-9._-]*$/u.test(value.archive) ||
    !Number.isSafeInteger(value.size) || value.size < 1 ||
    typeof value.sha256 !== "string" || !/^[0-9a-f]{64}$/u.test(value.sha256)) {
  throw new Error("authenticated descriptor has invalid operator coordinates");
}
console.log(`${value.archive}\t${value.size}`);
BUN
)" || die "The authenticated release descriptor for Luma $RELEASE_VERSION names no valid operator archive."
IFS="$(printf '\t')" read -r OPERATOR_ARCHIVE OPERATOR_SIZE <<<"$OPERATOR_FIELDS"
download_release_asset "$OPERATOR_ARCHIVE" "$OPERATOR_SIZE" "$BOOTSTRAP_TMP/$OPERATOR_ARCHIVE"
checksum_listed "$BOOTSTRAP_TMP/$RELEASE_CHECKSUMS" "$OPERATOR_ARCHIVE" "$BOOTSTRAP_TMP" ||
  die "operator archive did not match the signed $RELEASE_CHECKSUMS."
DATA_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/luma"
OPERATORS_ROOT="$DATA_ROOT/operators"
create_data_dirs "$DATA_ROOT"
INCOMING="$(mktemp -d "$OPERATORS_ROOT/.incoming.XXXXXX")"
tar -xzf "$BOOTSTRAP_TMP/$OPERATOR_ARCHIVE" --no-same-owner -C "$INCOMING"
EXTRACTED="$INCOMING/luma-operator-$RELEASE_VERSION"
[[ -d "$EXTRACTED" && ! -L "$EXTRACTED" ]] || die "operator archive has an unexpected root directory."
OPERATOR_DIR="$OPERATORS_ROOT/$RELEASE_VERSION"
if [[ -e "$OPERATOR_DIR" ]]; then
  [[ -d "$OPERATOR_DIR" && ! -L "$OPERATOR_DIR" ]] || die "operator destination is not a real directory."
  diff -qr "$EXTRACTED" "$OPERATOR_DIR" >/dev/null ||
    die "operator $RELEASE_VERSION already exists with different contents."
  rm -rf -- "$INCOMING"
else
  mv "$EXTRACTED" "$OPERATOR_DIR"
  rmdir "$INCOMING"
fi
CHANGE_STATE="Host tools and the authenticated operator release were preserved. Production configuration was not changed."
say "Authenticated and installed Luma $RELEASE_VERSION."

CURRENT_STAGE="Container registry access"
stage "Container registry access"
if [[ -n "$GH_TOKEN" ]]; then
  say "Logging Docker into GHCR with the same in-memory token. Docker stores it in Luma's private Docker configuration, which every deploy uses."
  CHANGE_STATE="Host tools and the operator release were preserved. Docker may have updated its GHCR login; production configuration was not changed."
  docker_login "$DOCKER_MODE" "$GITHUB_USER" "$DATA_ROOT/build"
  save_github_token "${XDG_CONFIG_HOME:-$HOME/.config}/luma/secrets"
  say "Saved the token for downloading Luma updates (mode 0600, in Luma's secrets directory)."
  CHANGE_STATE="Host tools, the operator release, Docker's GHCR login, and the saved update token were preserved. Production configuration was not changed."
else
  say "Luma's images are public, so Docker needs no GHCR login and no token is saved."
fi

CURRENT_STAGE="Configure and deploy production"
stage "Configure, deploy, and open Guided Setup"
CHANGE_STATE="Host tools, operator access, and any completed production configuration or server deployment step were preserved."
if $UNATTENDED; then
  say "Configuring https://$UNATTENDED_DOMAIN from the LUMA_* settings, then deploying and verifying it."
  run_operator_unattended
else
  say "The operator now asks only for the domain, certificate email, owner, features, public Pin IPv4, and how this server gets updates."
  if ! run_operator "$DOCKER_MODE" "$OPERATOR_DIR"; then
    die "Operator onboarding did not finish. Follow its stage-specific recovery check above, then safely rerun this bootstrap."
  fi
fi
note "Operator release: $OPERATOR_DIR"

finish
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
