<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="android.uid.system"
    tools:ignore="Deprecated">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:allowBackup="false"
        android:label="Ai Pin Revival Injector"
        android:process="system">

        <!-- Auto-inject at boot. Priority 999 ensures we run before Humane's
             own boot receivers (GrandCentralBootReceiver, etc.) so PMS is
             mutated before ironman's process is ever forked. -->
        <receiver
            android:name=".BootInjectionReceiver"
            android:process="system"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Manual injection trigger (kept for development/debugging) -->
        <receiver
            android:name=".InjectReceiver"
            android:process="system"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.penumbraos.hook.INJECT" />
                <action android:name="com.penumbraos.hook.INJECT_CONFIGURED_TARGETS" />
            </intent-filter>
        </receiver>

        <!-- Re-apply the exact Server's transient seInfo after a keep-data
             package replacement. Android 12L does not deliver the implicit
             PACKAGE_REPLACED broadcast to this target-SDK-32 manifest
             receiver, so the updater explicitly invokes this fixed component.
             The action has no package input and remains limited to
             DUMP-authorized physical recovery callers. -->
        <receiver
            android:name=".ServerRuntimePolicyRepairReceiver"
            android:process="system"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.penumbraos.hook.REPAIR_SERVER_RUNTIME_POLICY" />
            </intent-filter>
        </receiver>

        <!-- Legacy physical-recovery bridge. Disabled by default and callable
             only by a DUMP-authorized shell after explicitly enabling the
             component; routine administration uses the authenticated dashboard. -->
        <receiver
            android:name=".AdbBridgeReceiver"
            android:process="system"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.penumbraos.hook.ADB_BRIDGE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
