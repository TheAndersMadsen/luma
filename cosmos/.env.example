# Local-only runnable settings. Parity and production environments must use mTLS.
CARRY_WORKLOAD=ai-bus
CARRY_ENVIRONMENT=development
CARRY_INSTANCE_ID=local-1
CARRY_TRUST_DOMAIN=carry.local
CARRY_REGION=eastus
CARRY_REVISION=local
CARRY_POD_NAME=ai-bus-local-local-1
CARRY_GRPC_BIND=127.0.0.1:50051
CARRY_HTTP_BIND=127.0.0.1:8080
CARRY_AUTH_MODE=development-insecure
CARRY_MAX_DECODE_BYTES=4194304
CARRY_MAX_ENCODE_BYTES=4194304
CARRY_REQUEST_TIMEOUT_MS=15000
CARRY_SHUTDOWN_GRACE_MS=5000
CARRY_LOG_LEVEL=info

# Parity/production use edge-authenticated. Istio validates the client
# certificate, strips any caller-supplied copy of the metadata, and injects the
# authenticated principal before forwarding to this workload.
# CARRY_AUTH_MODE=edge-authenticated
# CARRY_EDGE_PRINCIPAL_METADATA=x-carry-authenticated-principal

# Assistant model backend (OpenAI-compatible endpoint)
# For OpenRouter:
# CARRY_LLM_BASE_URL=https://openrouter.ai/api/v1
# CARRY_LLM_API_KEY=<your key>
# VPS env-file alternative (avoids empty Compose interpolation overriding it):
# CARRY_OPENROUTER_API_KEY=<your key>
# CARRY_LLM_MODEL=openai/gpt-5.6-luna
CARRY_LLM_BASE_URL=
CARRY_LLM_API_KEY=
CARRY_OPENROUTER_API_KEY=
CARRY_LLM_MODEL=openai/gpt-5.6-luna
# Per-step reasoning effort: minimal | low | medium | high. Unset sends nothing
# and inherits the backend's default.
#
# Measured on this stack: picking one tool out of ten costs 3.1-4.0s and arrives
# with ~400 characters of reasoning, while the tool it picks (`weather`) answers
# in 390ms — most of a lookup turn is deliberation about which lookup to make.
# Lowering it is therefore the largest latency lever available, and it is priced
# in tool-choice accuracy. Measure BOTH before enabling: a fast wrong answer is
# worse for the wearer than a slow right one.
CARRY_LLM_REASONING_EFFORT=
CARRY_LLM_MAX_TOKENS=512
# Optional multimodal override; falls back to CARRY_LLM_MODEL.
CARRY_VISION_MODEL=
# Optional small model for loading/interstitial blurbs. This stays separate
# from the tool-capable main model and may point at a local OpenAI-compatible
# endpoint that needs no credential.
CARRY_INTERSTITIAL_BASE_URL=
CARRY_INTERSTITIAL_MODEL=
CARRY_INTERSTITIAL_API_KEY=
CARRY_DEMO_ENABLED=false

# Third-party service backends used by server-side tools
# Leave unset if you want "capability unavailable" responses.
CARRY_SERPAPI_KEY=
CARRY_GOOGLE_MAPS_KEY=
CARRY_PIRATE_WEATHER_KEY=
CARRY_WOLFRAM_APP_ID=
CARRY_PPLX_API_KEY=
# Optional Perplexity model override (default: "sonar")
CARRY_PPLX_MODEL=

# Optional Azure AI Speech backend for stock TextToSpeech RPCs.
# AZURE_SPEECH_KEY must be injected from a local/VPS secret store; never commit it.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural
# Independent feature-flag gate; enable only when ai-bus has working Azure credentials.
CARRY_REMOTE_TTS_ENABLED=false

# Clone-owned capture endpoints. The server appends /capture/{token}.
# These must be absolute HTTP(S) URLs without embedded credentials, query, or fragment.
CARRY_CAPTURE_SHARE_BASE_URL=
# Shared with Center so Cosmos-generated links can be opened by the public share view.
CARRY_SHARE_TOKEN_SECRET=
# Leave this empty and EVERY photo and video upload answers UNIMPLEMENTED: the pin
# never receives a URL, the PUT route is never reached, and captures stay stranded
# on the device (the upload worker treats the failure as retryable, so it retries
# forever and never frees the capture directory). compose.yaml defaults it to the
# ai-bus HTTP listener; set it here for a non-compose deployment.
CARRY_CAPTURE_UPLOAD_BASE_URL=
# Where uploaded captures are written. Must be on durable storage — this is the
# wearer's only copy once the device sees UPLOAD_SUCCESS and deletes its own.
# Unset means UploadFile refuses honestly rather than pretending to store.
CARRY_CAPTURE_STORAGE_DIR=
# Per-upload body cap in bytes (default 32 MiB).
CARRY_CAPTURE_MAX_UPLOAD_BYTES=
# Operator-controlled service that returns {url,s3_key,bucket_name} JSON.
CARRY_UPLOAD_PRESIGN_ENDPOINT=

# Real catalog providers used by smart playlists and visual shopping search.
CARRY_MUSICBRAINZ_BASE_URL=https://musicbrainz.org
CARRY_SHOPPING_VISUAL_SEARCH_URL=
# Comma-separated exact hostnames; the endpoint host must appear here.
CARRY_SHOPPING_ALLOWED_HOSTS=
CARRY_SHOPPING_API_KEY=

# --- Shared persistence -------------------------------------------------
# PostgreSQL connection string. Unset keeps the IN-MEMORY store, which is
# per-process: with more than one replica each pod holds its own island of
# state, and nothing survives a restart. Set this for any real deployment.
# A configured-but-unreachable database is a hard startup failure by design —
# falling back to memory would come up healthy and serve every wearer an empty
# account. Schema creation is idempotent and serialized across replicas by a
# Postgres advisory lock, so several pods may start together against a fresh
# database.
CARRY_DATABASE_URL=

# --- DeviceUser enrollment ----------------------------------------------
# The CA that signs DeviceUser certificates during onboarding (PEM file paths).
# Both must be set together, and the key must match the certificate.
#
# Leave BOTH unset to keep enrollment switched OFF: CreateLoginInit,
# CreateLoginFinish and CreateDeviceUserBinding answer UNIMPLEMENTED and
# VerifyHmcByPass answers Disallowed, so a Pin is never invited into a ceremony
# that cannot finish. No CA is ever generated on the fly — an ephemeral,
# per-process CA would issue certificates that no other replica (and no restart)
# would honour.
#
# When enabling: mount the SAME key material into EVERY provisioning replica and
# add the CA to the edge's DeviceUser trust bundle, or a Pin that enrolls against
# one pod cannot authenticate against another. Set CARRY_DATABASE_URL too — the
# OPAQUE ceremony spans three RPCs that may land on different pods, and the
# in-memory enrollment store is per-process.
CARRY_DUC_CA_CERT=
CARRY_DUC_CA_KEY=

# Refuse instead of accepting a device-attestation signature the workload cannot
# verify. Only meaningful when the edge forwards the client certificate in the
# x-forwarded-client-cert `Cert=` element; auth.rs is otherwise given only
# `Subject=`, so there is no attestation public key to check against.
CARRY_REQUIRE_DEVICE_ATTESTATION=false

# OPAQUE login state is process-local unless CARRY_DATABASE_URL is set. Provisioning
# may run multiple replicas, where CreateLoginInit and CreateLoginFinish
# can land on different pods and enrollment can then never complete. The server
# refuses to start in that configuration; set this only if you really run exactly
# one provisioning replica.
CARRY_ALLOW_SINGLE_REPLICA_ENROLLMENT=false

# Clone enrollment credential and fallback owner. In any remote deployment
# these are required protected environment values, never Compose literals.
CARRY_ENROLLMENT_PINCODE=
CARRY_ENROLLMENT_USER_ID=

# Proof that a request reached a workload THROUGH the mTLS edge.
#
# `x-forwarded-client-cert` is only trustworthy because Envoy strips any
# client-supplied copy and rewrites it from the verified certificate. A workload
# reached by any other route — a published port, or another container on the same
# network — is just believing a header the caller chose. The workloads cannot tell
# the edge apart by address (socat makes every connection look local), so the edge
# presents this shared secret instead and Envoy strips inbound copies of it.
# Purpose-scoped Center BFF credential. It may only upgrade a verified wearer
# principal to the authenticated web projection used by expiring share links.
# Never reuse CARRY_ADMIN_TOKEN here.
# CARRY_CENTER_PROJECTION_TOKEN=<random 32+ byte secret shared only with Center>
#
# UNSET MEANS UNENFORCED, which keeps local runs working. Set it in any
# deployment a device talks to, on BOTH the workloads and the edge's
# request_headers_to_add.
CARRY_EDGE_TOKEN=

# ── Web login (Keycloak / OIDC) ──────────────────────────────────────────────
# The account plane: a Bearer token from a Center login is verified here so a
# person's browser and their Pin resolve to the SAME data partition (U:<sub> for
# the web login, U:<user> from the device certificate CN — one identity).
#
# UNSET ISSUER = plane off (device-only), the default. To turn it on, bring up
# the identity provider and point the workloads at it:
#
#   docker compose --profile identity up -d keycloak
#
# then uncomment these. `iss` is validated against the EXTERNAL issuer the
# browser sees; JWKS is fetched over the INTERNAL service name (split-horizon),
# so tokens stay valid no matter which side asks. Mint a test token with:
#
#   curl -s -X POST http://localhost:8088/realms/humane/protocol/openid-connect/token \
#     -d client_id=center -d client_secret=center-dev-secret \
#     -d username=wearer -d password=wearer -d grant_type=password
#
# CARRY_OIDC_ISSUER=http://localhost:8088/realms/humane
# CARRY_OIDC_JWKS_URI=http://keycloak:8080/realms/humane/protocol/openid-connect/certs
# Audience is left unset on purpose: Keycloak access tokens carry `aud: account`,
# not the client id, so enforcing the client would reject every real token. Set
# it only if your IdP mints a client-scoped audience.
# CARRY_OIDC_AUDIENCE=

# Keycloak admin bootstrap (dev only — the `identity` compose profile).
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# Required by the production VPS Keycloak override. Store only in the protected
# VPS Compose environment; the identity database is separate from Carry data.
CARRY_KEYCLOAK_DB_PASSWORD=
